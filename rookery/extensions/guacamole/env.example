# Optional Guacamole extension
EVENT_EXTENSIONS=guacamole

# These settings are accepted only while the Guacamole extension is selected.
# The root .env.example keeps the complete blank catalogue for one-file setup.

# Custom helpers are JSON argv arrays. Supported placeholders are documented by
# each command's --help and the extension README. Export transports emit file bytes
# on stdout; Rookery writes the bounded local artifact.
GUAC_REMOTE_FILE_EXPORT_ARGV=
GUAC_CLIPBOARD_EXPORT_ARGV=
GUAC_BASE64_EXPORT_ARGV=
GUAC_HTTP_EXPORT_ARGV=
GUAC_SCREENSHOT_TRANSCRIBE_ARGV=
GUAC_TERMINAL_CAPTURE_ARGV=
GUAC_SSH_EXEC_ARGV=

# Each custom transport starts with Rookery's minimal runtime environment. Add
# only exact environment-key names that its command needs, as JSON arrays. A
# listed key must be present in .env or the invoking parent before any output
# directory or child process is created. Do not use wildcards or KEY=value.
GUAC_REMOTE_FILE_EXPORT_ENV_KEYS=[]
GUAC_CLIPBOARD_EXPORT_ENV_KEYS=[]
GUAC_BASE64_EXPORT_ENV_KEYS=[]
GUAC_HTTP_EXPORT_ENV_KEYS=[]
GUAC_SCREENSHOT_TRANSCRIBE_ENV_KEYS=[]
GUAC_TERMINAL_CAPTURE_ENV_KEYS=[]

# A custom SSH sender receives only this list. SSH_AUTH_SOCK is excluded unless
# it appears here explicitly. The xdotool fallback receives only interactive
# desktop variables (DISPLAY, WAYLAND_DISPLAY, XAUTHORITY, and DBUS_SESSION_BUS_ADDRESS).
GUAC_SSH_EXEC_ENV_KEYS=[]

# Optional relative or absolute stream/tile directory for guac-contact-sheet.
# ImageMagick receives the minimal runtime environment only. Execution timeout
# is an integer from 1 through 3600 seconds.
GUAC_STREAM_DIR=
GUAC_EXEC_TIMEOUT=120
