# Selected CTFd adapter using a sealed Windows Chrome gateway session.
PLATFORM_ADAPTER=ctfd_browser_gateway
CTFD_URL=
CTFD_TOKEN=
# Optional JSON string array of exact proxy/CA names for token CTFd requests.
# Empty keeps proxy routing and CA overrides out of the token transport.
CTFD_NETWORK_ENV_KEYS=[]
BROWSER_MODE=cdp
BROWSER_CDP_URL=http://127.0.0.1:9001
BROWSER_GATEWAY_URL=http://127.0.0.1:9003
ADAPTER_CONFIG_BASE_URL=
ADAPTER_CONFIG_TOKEN_ENV=CTFD_TOKEN
# user or team; account is required and team is required only in team mode.
ADAPTER_CONFIG_SCORING_MODE=team
ADAPTER_CONFIG_EXPECTED_ACCOUNT_ID=
ADAPTER_CONFIG_EXPECTED_TEAM_ID=
ADAPTER_CONFIG_CSRF_PAGE_PATH=/challenges
# Lease 1..300 seconds; timeout 1..120; response bound 1024..16777216 bytes.
ADAPTER_CONFIG_SESSION_LEASE_SECONDS=60
ADAPTER_CONFIG_TIMEOUT=30
ADAPTER_CONFIG_MAX_RESPONSE_BYTES=262144
# Duplicate-free JSON array of exact lower-case HTTPS support origins.
ADAPTER_CONFIG_BROWSER_SUPPORT_ORIGINS=[]
