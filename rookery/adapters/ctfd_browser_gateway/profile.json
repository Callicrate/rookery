{
  "adapter": {
    "config": {
      "max_response_bytes": 262144,
      "session_lease_seconds": 60,
      "token_env": "CTFD_TOKEN",
      "timeout": 30
    },
    "id": "ctfd_browser_gateway"
  },
  "capabilities": {
    "optional": [
      "release_changes",
      "network",
      "collaboration"
    ],
    "required": [
      "local_shell",
      "browser_cdp",
      "browser_gateway",
      "platform_inventory",
      "challenge_details",
      "scoring"
    ]
  },
  "profile": "ctfd_browser_gateway",
  "release": {
    "model": "poll",
    "poll_seconds": 60
  },
  "scoring": {
    "action_kinds": [
      "flag",
      "no_submit_evidence"
    ],
    "completion_mode": "scorer_truth"
  },
  "session": {
    "dynamic_attempts": false,
    "lifecycle": "browser-gateway-session",
    "required_freshness_seconds": 900
  },
  "surface": {
    "bundles": [
      "core",
      "research",
      "scoring-review",
      "writeups",
      "unstick"
    ]
  }
}
