# Optional Hack The Box adapter
PLATFORM_ADAPTER=htb
# JSON argv arrays consumed by the generic CommandAdapter.
ADAPTER_CONFIG_INVENTORY_ARGV=
ADAPTER_CONFIG_SUBMIT_ARGV=
# Exact, separate names passed only to the selected inventory or submit command.
ADAPTER_CONFIG_INVENTORY_ENV_KEYS=[]
ADAPTER_CONFIG_SUBMIT_ENV_KEYS=[]
