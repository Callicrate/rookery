# Optional CTFd adapter
PLATFORM_ADAPTER=ctfd
CTFD_URL=
CTFD_TOKEN=
# Optional JSON string array of exact proxy/CA names for CTFd requests only.
# Empty keeps proxy routing and CA overrides out of CTFd transport.
CTFD_NETWORK_ENV_KEYS=[]
# Exact HTTPS origin; blank uses CTFD_URL. TOKEN_ENV names the private token slot.
ADAPTER_CONFIG_BASE_URL=
ADAPTER_CONFIG_TOKEN_ENV=CTFD_TOKEN
# Request timeout is 1..120 seconds; response bound is 1024..16777216 bytes.
ADAPTER_CONFIG_TIMEOUT=30
ADAPTER_CONFIG_MAX_RESPONSE_BYTES=262144
