# Selected CTFd adapter using an already-authenticated local browser session.
PLATFORM_ADAPTER=ctfd_browser
CTFD_URL=
# Optional bearer token tried before cookie relay. Keep the value only in private .env.
CTFD_TOKEN=
BROWSER_MODE=cdp
BROWSER_CDP_URL=http://127.0.0.1:9001
# Set BROWSER_MODE=bidi and use this endpoint for an authenticated Firefox profile.
BROWSER_BIDI_URL=ws://127.0.0.1:9223/session
ADAPTER_CONFIG_BASE_URL=
# user or team; account is required and team is required only in team mode.
ADAPTER_CONFIG_SCORING_MODE=team
ADAPTER_CONFIG_EXPECTED_ACCOUNT_ID=
ADAPTER_CONFIG_EXPECTED_TEAM_ID=
# Optional bounded target identity for a single scoring target.
ADAPTER_CONFIG_TARGET_ID=
ADAPTER_CONFIG_CSRF_PAGE_PATH=/challenges
# Lease 1..300 seconds; timeout 1..120; response bound 1024..16777216 bytes.
ADAPTER_CONFIG_SESSION_LEASE_SECONDS=60
ADAPTER_CONFIG_TIMEOUT=30
ADAPTER_CONFIG_MAX_RESPONSE_BYTES=262144
# Set to 1 only for a platform that explicitly exposes sequential positions.
ADAPTER_CONFIG_SEQUENTIAL_UNLOCK=0
