# Optional Immersive adapter
PLATFORM_ADAPTER=immersive
# JSON argv arrays. Placeholders are substituted once into individual arguments.
ADAPTER_CONFIG_INVENTORY_ARGV=
ADAPTER_CONFIG_SUBMIT_ARGV=
# Exact, separate key arrays passed only to the selected child command.
ADAPTER_CONFIG_INVENTORY_ENV_KEYS=[]
ADAPTER_CONFIG_SUBMIT_ENV_KEYS=[]
# Read-only selected-lab refresh. The custom argv child receives only the
# exact names listed here, plus the minimal runtime environment.
IMMERSIVE_SELECTED_LAB_REFRESH_ARGV=
IMMERSIVE_SELECTED_LAB_REFRESH_ENV_KEYS=[]
# Optional read-only URL/query and local cookie-export reference.
IMMERSIVE_GRAPHQL_URL=
IMMERSIVE_SELECTED_LAB_QUERY=
IMMERSIVE_ACTIONCABLE_URL=
IMMERSIVE_ORIGIN=
IMMERSIVE_COOKIES_FILE=
# In-process Immersive HTTP/WebSocket traffic ignores ambient proxy/CA
# discovery. Name only HTTP_PROXY, HTTPS_PROXY, ALL_PROXY, NO_PROXY, and/or
# CODEX_CA_CERTIFICATE, SSL_CERT_FILE, REQUESTS_CA_BUNDLE, CURL_CA_BUNDLE,
# NODE_EXTRA_CA_CERTS, GIT_SSL_CAINFO here; unresolved or invalid names fail closed.
IMMERSIVE_NETWORK_ENV_KEYS=[]
EVENT_EXTENSIONS=guacamole
