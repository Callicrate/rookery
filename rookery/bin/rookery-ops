#!/usr/bin/env -S python3 -I -B
"""Operational accelerators without control-plane ownership."""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import json
import os
import stat
import sys
import tempfile
import uuid
from pathlib import Path
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "lib"))
sys.dont_write_bytecode = True
from rookery.portable.adapters import run_bounded_argv  # noqa: E402
from rookery.portable.compat import execute_plan_alias  # noqa: E402
from rookery.portable.control import mutation_guard  # noqa: E402
from rookery.portable.environment import (  # noqa: E402
    EnvironmentPolicyError,
    build_child_environment,
    parse_name_array,
    purpose_policy,
)
from rookery.portable.store import EventStore  # noqa: E402
from rookery.portable.telemetry import sealed_plan_file_matches  # noqa: E402
from rookery.portable.util import (  # noqa: E402
    file_lock,
    iso_now,
    safe_relative,
    sha256_file,
)


def _private_error(path: Path) -> ValueError:
    return ValueError(f"private path must be a regular non-symlink path: {path}")


def private_dir(p: Path) -> Path:
    path = Path(os.path.abspath(os.fspath(p)))
    workspace = Path(os.path.abspath(os.fspath(ROOT)))
    try:
        relative = path.relative_to(workspace)
    except ValueError:
        missing = []
        current = path
        while not os.path.lexists(current):
            missing.append(current)
            if current.parent == current:
                raise _private_error(path)
            current = current.parent
        state = os.lstat(current)
        if stat.S_ISLNK(state.st_mode) or not stat.S_ISDIR(state.st_mode):
            raise _private_error(current)
        for current in reversed(missing):
            os.mkdir(current, 0o700)
            os.chmod(current, 0o700)
        os.chmod(path, 0o700)
        return path
    current = workspace
    for part in relative.parts:
        current /= part
        if os.path.lexists(current):
            state = os.lstat(current)
            if stat.S_ISLNK(state.st_mode) or not stat.S_ISDIR(state.st_mode):
                raise _private_error(current)
        else:
            os.mkdir(current, 0o700)
        os.chmod(current, 0o700)
    return path


def private_file(p: Path) -> bool:
    path = Path(p)
    private_dir(path.parent)
    if not os.path.lexists(path):
        return False
    state = os.lstat(path)
    if stat.S_ISLNK(state.st_mode) or not stat.S_ISREG(state.st_mode):
        raise _private_error(path)
    os.chmod(path, 0o600)
    return True


@contextlib.contextmanager
def private_lock(p: Path):
    path = Path(p)
    lock = path.with_name(f".{path.name}.lock")
    private_file(lock)
    descriptor = os.open(
        lock,
        os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    try:
        state = os.fstat(descriptor)
        if not stat.S_ISREG(state.st_mode):
            raise _private_error(lock)
        os.chmod(lock, 0o600)
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(descriptor, fcntl.LOCK_UN)
        os.close(descriptor)


def write_private_text(p: Path, text: str) -> None:
    path = Path(p)
    private_file(path)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        private_file(path)
        os.replace(temporary, path)
        os.chmod(path, 0o600)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if temporary.exists():
            temporary.unlink()


def append_jsonl(path: Path, obj: Any) -> None:
    row = (json.dumps(obj, sort_keys=True, ensure_ascii=False) + "\n").encode("utf-8")
    with private_lock(path):
        private_file(path)
        descriptor = os.open(
            path,
            os.O_WRONLY | os.O_APPEND | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0),
            0o600,
        )
        try:
            state = os.fstat(descriptor)
            if not stat.S_ISREG(state.st_mode):
                raise _private_error(path)
            os.chmod(path, 0o600)
            written = 0
            while written < len(row):
                written += os.write(descriptor, row[written:])
            os.fsync(descriptor)
        finally:
            os.close(descriptor)


def platform_inventory(args):
    p = EventStore(ROOT).rebuild()["current"].get("platform", {})
    print(json.dumps(p, indent=2))
    return 0


def target_inventory(args):
    path = ROOT / "state/target_inventory.jsonl"
    if args.tcmd == "list":
        rows = []
        if os.path.lexists(path):
            private_file(path)
            for line in path.read_text(errors="replace").splitlines():
                try:
                    rows.append(json.loads(line))
                except Exception:
                    pass
        print(json.dumps(rows, indent=2))
        return 0
    if args.tcmd == "add":
        scope_environment = build_child_environment(
            ROOT, policy=purpose_policy("rookery-ops-scope")
        )
        result = run_bounded_argv(
            [str(ROOT / "bin/scope-check"), "check-host", args.host],
            cwd=ROOT,
            timeout=30,
            max_output_bytes=64 * 1024,
            env=scope_environment,
        )
        if result.returncode != 0 or result.termination != "exited":
            raise RuntimeError("target inventory host was rejected by scope")
        row = {
            "target_id": "target_" + uuid.uuid4().hex,
            "host": args.host,
            "ports": args.ports,
            "status": args.status,
            "confidence": args.confidence,
            "source": args.source,
            "scoring_path": args.scoring_path,
            "notes": args.notes,
            "last_seen_at": iso_now(),
        }
        append_jsonl(path, row)
        print(json.dumps(row, indent=2))
        return 0
    raise SystemExit("import-nmap was removed; use range-sweep outputs and explicit target-inventory add")


def cleanup(args):
    path = ROOT / "state/cleanup_hooks.jsonl"
    if args.ccmd == "register":
        if args.command:
            raise RuntimeError(
                "cleanup shell strings are disabled; use --argv-json"
            )
        try:
            command_argv = json.loads(args.argv_json)
        except json.JSONDecodeError as exc:
            raise ValueError("cleanup argv must be valid JSON") from exc
        if (
            not isinstance(command_argv, list)
            or not command_argv
            or len(command_argv) > 128
            or any(
                not isinstance(argument, str)
                or not argument
                or len(argument) > 8_192
                for argument in command_argv
            )
        ):
            raise ValueError("cleanup argv must be a bounded non-empty string array")
        pass_names = parse_name_array(
            json.dumps(args.pass_env), label="cleanup pass-env"
        )
        row = {
            "cleanup_id": args.id or "cleanup_" + uuid.uuid4().hex,
            "label": args.label,
            "command_argv": command_argv,
            "owner": args.owner,
            "target": args.target,
            "reason": args.reason,
            "pass_env": list(pass_names),
            "registered_at": iso_now(),
            "status": "registered",
        }
        append_jsonl(path, row)
        print(json.dumps(row, indent=2))
        return 0
    rows = []
    if os.path.lexists(path):
        private_file(path)
        for line in path.read_text(errors="replace").splitlines():
            try:
                rows.append(json.loads(line))
            except Exception:
                pass
    if args.ccmd == "list":
        print(json.dumps(rows, indent=2))
        return 0
    selected = [r for r in rows if not args.id or r.get("cleanup_id") == args.id]
    results = []
    store = EventStore(ROOT)
    observed_generation = store.current_stop_generation()
    for row in selected:
        if args.dry_run:
            results.append({**row, "dry_run": True})
            continue
        try:
            command_argv = row.get("command_argv")
            if not isinstance(command_argv, list) or not command_argv:
                raise RuntimeError("legacy cleanup shell command is disabled")
            recorded_names = row.get("pass_env", [])
            if not isinstance(recorded_names, list):
                raise RuntimeError("cleanup pass-env record is invalid")
            pass_names = parse_name_array(
                json.dumps(recorded_names), label="cleanup pass-env"
            )
            environment = build_child_environment(
                ROOT,
                policy=purpose_policy("rookery-ops-cleanup"),
                pass_names=pass_names,
            )
            with file_lock(ROOT / "state" / "mutation.lock"):
                mutation_guard(store, observed_generation)
                cp = run_bounded_argv(
                    [str(argument) for argument in command_argv],
                    cwd=ROOT,
                    timeout=args.timeout,
                    max_output_bytes=args.max_output_bytes,
                    env=environment,
                )
        except (EnvironmentPolicyError, RuntimeError, ValueError) as exc:
            results.append({**row, "blocked": True, "error": str(exc)})
            break
        results.append(
            {
                **row,
                "returncode": cp.returncode,
                "termination": cp.termination,
                "stdout": cp.stdout[-1000:].decode("utf-8", errors="replace"),
                "stderr": cp.stderr[-1000:].decode("utf-8", errors="replace"),
                "environment": cp.environment,
            }
        )
    print(json.dumps(results, indent=2))
    return (
        0
        if all(
            not row.get("blocked")
            and row.get("returncode", 0) == 0
            and row.get("termination", "exited") == "exited"
            for row in results
        )
        else 1
    )


def credential(args):
    path = ROOT / "evidence/credential_ledger.jsonl"
    if args.kcmd == "list":
        if os.path.lexists(path):
            private_file(path)
        print(path.read_text(errors="replace") if os.path.lexists(path) else "")
        return 0
    row = {
        "credential_id": args.id or "cred_" + uuid.uuid4().hex,
        "principal": args.principal,
        "secret_ref": args.secret_ref,
        "secret_type": args.secret_type,
        "domain": args.domain,
        "source": args.source,
        "privileges": args.privileges,
        "protocols_tested": args.protocols_tested,
        "validity": args.validity,
        "last_validated": args.last_validated or iso_now(),
        "notes": args.notes,
    }
    append_jsonl(path, row)
    print(json.dumps(row, indent=2))
    return 0


def key_search(args):
    base = Path(args.root)
    base = base if base.is_absolute() else ROOT / base
    rows = []
    for p in base.rglob("*"):
        if not p.is_file() or p.stat().st_size > args.max_size:
            continue
        try:
            text = p.read_text(errors="ignore")
        except Exception:
            continue
        if "BEGIN" in text and "PRIVATE KEY" in text:
            rows.append({"path": str(p), "sha256": sha256_file(p), "bytes": p.stat().st_size})
    print(json.dumps(rows, indent=2))
    return 0


REFERENCE_STATUSES = (
    "empty",
    "missing",
    "rejected",
    "present_file",
    "present_directory",
)


def _evidence_references(store: EventStore) -> list[dict[str, Any]]:
    references: list[dict[str, Any]] = []
    events = store.events()
    plans = {
        str(event["payload"].get("plan_id") or ""): event["payload"]
        for event in events
        if event["event_type"] == "execution.planned"
    }
    for event in events:
        payload = event["payload"]
        plan_id = str(payload.get("plan_id") or "")
        if event["event_type"] == "execution.planned":
            values = payload.get("evidence_paths", [])
            if not isinstance(values, list):
                values = [values]
            if not values:
                values = [""]
            references.extend(
                {
                    "kind": "plan_evidence",
                    "plan_id": plan_id,
                    "path": str(value or ""),
                    "required": True,
                }
                for value in values
            )
        elif event["event_type"] in {
            "execution.completed",
            "execution.rejected",
            "execution.blocked",
            "execution.failed",
        }:
            required = event["event_type"] in {
                "execution.completed",
                "execution.rejected",
            }
            plan = plans.get(plan_id, {})
            no_submit = plan.get("semantic_action") == "no_submit_evidence"
            if not no_submit:
                references.append(
                    {
                        "kind": "response",
                        "plan_id": plan_id,
                        "path": str(payload.get("response_path") or ""),
                        "required": required,
                    }
                )
            evidence_root = payload.get("evidence_root")
            envelope = plan.get("envelope") if isinstance(plan, dict) else None
            if (
                no_submit
                and isinstance(envelope, dict)
                and envelope.get("artifact_reference") == ""
            ):
                evidence_root = plan.get("plan_path")
            if not no_submit or evidence_root:
                references.append(
                    {
                        "kind": "execution_evidence",
                        "plan_id": plan_id,
                        "path": str(evidence_root or ""),
                        "required": required,
                    }
                )
    return references


def _value_only_no_submit_plan_validity(events: list[dict[str, Any]]) -> set[str]:
    """Return value-only no-submit plans whose sealed evidence is not canonical."""

    plans = {
        str(event["payload"].get("plan_id") or ""): event["payload"]
        for event in events
        if event["event_type"] == "execution.planned"
    }
    terminals: dict[str, dict[str, Any]] = {}
    for event in events:
        if event["event_type"] not in {"execution.completed", "execution.rejected"}:
            continue
        plan_id = str(event["payload"].get("plan_id") or "")
        if plan_id:
            terminals[plan_id] = event
    invalid: set[str] = set()
    for plan_id, plan in plans.items():
        envelope = plan.get("envelope") if isinstance(plan, dict) else None
        if (
            plan.get("semantic_action") != "no_submit_evidence"
            or not isinstance(envelope, dict)
            or envelope.get("artifact_reference") != ""
        ):
            continue
        terminal = terminals.get(plan_id)
        if (
            terminal is None
            or terminal["payload"].get("evidence_root") != ""
            or not sealed_plan_file_matches(ROOT, plan)
        ):
            invalid.add(plan_id)
    return invalid


def _resolve_manifest_reference(reference: dict[str, Any]) -> dict[str, Any]:
    value = reference["path"]
    if not value:
        return {**reference, "status": "empty"}
    try:
        path = safe_relative(ROOT, value)
    except (OSError, ValueError):
        return {**reference, "status": "rejected"}
    if path.is_file():
        return {
            **reference,
            "path": path.relative_to(ROOT).as_posix(),
            "status": "present_file",
            "bytes": path.stat().st_size,
            "sha256": sha256_file(path),
        }
    if path.is_dir():
        return {
            **reference,
            "path": path.relative_to(ROOT).as_posix(),
            "status": "present_directory",
        }
    return {**reference, "status": "missing"}


def _reference_counts(references: list[dict[str, Any]]) -> dict[str, int]:
    return {
        status: sum(reference["status"] == status for reference in references)
        for status in REFERENCE_STATUSES
    }


def evidence_manifest(args: argparse.Namespace) -> int:
    if args.max_files <= 0 or args.max_bytes <= 0:
        raise ValueError("manifest bounds must be positive")
    output = ROOT / "evidence/latest-manifest.json"
    bases = [
        ROOT / "analysis",
        ROOT / "evidence",
        ROOT / "submissions",
        ROOT / "platform",
        ROOT / "writeups",
        ROOT / "logs/commands",
        ROOT / "logs/jobs",
        ROOT / "state/execution_plans",
    ]
    fixed = [ROOT / "state/events.jsonl", ROOT / "state/events.sqlite3"]
    files: dict[str, dict[str, Any]] = {}
    total_bytes = 0
    truncated = False
    candidates: list[Path] = list(fixed)
    for base in bases:
        if not base.is_dir():
            continue
        for directory, subdirectories, names in os.walk(base, followlinks=False):
            subdirectories[:] = [
                name
                for name in subdirectories
                if not (Path(directory) / name).is_symlink()
            ]
            candidates.extend(Path(directory) / name for name in names)
    for candidate in candidates:
        if len(files) >= args.max_files:
            truncated = True
            break
        try:
            path = candidate.resolve(strict=True)
            path.relative_to(ROOT.resolve())
        except (OSError, ValueError):
            continue
        if not path.is_file() or path == output.resolve(strict=False):
            continue
        size = path.stat().st_size
        if total_bytes + size > args.max_bytes:
            truncated = True
            break
        relative = path.relative_to(ROOT).as_posix()
        files[relative] = {
            "path": relative,
            "bytes": size,
            "sha256": sha256_file(path),
        }
        total_bytes += size
    store = EventStore(ROOT)
    invalid_value_only_plans = _value_only_no_submit_plan_validity(store.events())
    references = [
        _resolve_manifest_reference(reference)
        for reference in _evidence_references(store)
    ]
    for reference in references:
        if (
            reference.get("plan_id") in invalid_value_only_plans
            and reference.get("kind") == "execution_evidence"
        ):
            reference["status"] = "rejected"
    required_references = [
        reference for reference in references if reference["required"]
    ]
    optional_references = [
        reference for reference in references if not reference["required"]
    ]
    reference_counts = _reference_counts(references)
    required_reference_counts = _reference_counts(required_references)
    optional_reference_counts = _reference_counts(optional_references)
    incomplete = sum(
        required_reference_counts[status]
        for status in {"empty", "missing", "rejected"}
    )
    out = {
        "schema_version": "3",
        "created_at": iso_now(),
        "bounds": {"max_files": args.max_files, "max_bytes": args.max_bytes},
        "file_count": len(files),
        "total_bytes": total_bytes,
        "truncated": truncated,
        "files": [files[path] for path in sorted(files)],
        "reference_counts": reference_counts,
        "required_reference_count": len(required_references),
        "required_reference_counts": required_reference_counts,
        "optional_reference_count": len(optional_references),
        "optional_reference_counts": optional_reference_counts,
        "references": references,
        "complete": not truncated and incomplete == 0,
    }
    write_private_text(
        output,
        json.dumps(out, indent=2, sort_keys=True, ensure_ascii=False) + "\n",
    )
    print(
        json.dumps(
            {
                "count": len(files),
                "reference_counts": reference_counts,
                "required_reference_count": len(required_references),
                "required_reference_counts": required_reference_counts,
                "optional_reference_count": len(optional_references),
                "optional_reference_counts": optional_reference_counts,
                "complete": out["complete"],
                "truncated": truncated,
                "path": "evidence/latest-manifest.json",
            },
            indent=2,
        )
    )
    return 0 if out["complete"] or not args.require_complete else 2


def score_correlate(args):
    current = EventStore(ROOT).rebuild()["current"]
    rows = []
    for execution in current.get("executions", {}).values():
        if execution.get("action_kind") != "handle_write":
            continue
        rows.append(
            {
                "plan_id": execution.get("plan_id"),
                "proposal_id": execution.get("proposal_id"),
                "objective_id": execution.get("objective_id"),
                "status": execution.get("status"),
                "verdict": execution.get("verdict", {}).get("verdict", "unknown"),
                "response_path": execution.get("response_path", ""),
            }
        )
    print(json.dumps({"count": len(rows), "rows": rows}, indent=2))
    return 0


def verified_write(args):
    return execute_plan_alias(ROOT, args.plan_id, allowed_actions={"handle_write"})


def main():
    os.umask(0o077)
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    x = sub.add_parser("platform-inventory")
    x.add_argument("--json", action="store_true")
    x.set_defaults(func=platform_inventory)
    x = sub.add_parser("target-inventory")
    xs = x.add_subparsers(dest="tcmd", required=True)
    y = xs.add_parser("add")
    y.add_argument("--host", required=True)
    y.add_argument("--ports", default="")
    y.add_argument("--status", default="up")
    y.add_argument("--confidence", default="medium")
    y.add_argument("--source", default="")
    y.add_argument("--scoring-path", default="")
    y.add_argument("--notes", default="")
    y.set_defaults(func=target_inventory)
    y = xs.add_parser("list")
    y.set_defaults(func=target_inventory)
    x = sub.add_parser("cleanup")
    xs = x.add_subparsers(dest="ccmd", required=True)
    y = xs.add_parser("register")
    y.add_argument("--id", default="")
    y.add_argument("--label", required=True)
    command_group = y.add_mutually_exclusive_group(required=True)
    command_group.add_argument("--argv-json")
    command_group.add_argument("--command")
    y.add_argument("--owner", default="coordinator")
    y.add_argument("--pass-env", action="append", default=[])
    y.add_argument("--target", default="")
    y.add_argument("--reason", default="")
    y.set_defaults(func=cleanup)
    y = xs.add_parser("list")
    y.set_defaults(func=cleanup)
    y = xs.add_parser("run")
    y.add_argument("--id", default="")
    y.add_argument("--dry-run", action="store_true")
    y.add_argument("--timeout", type=int, default=120)
    y.add_argument("--max-output-bytes", type=int, default=8 * 1024 * 1024)
    y.set_defaults(func=cleanup)
    x = sub.add_parser("credential-ledger")
    xs = x.add_subparsers(dest="kcmd", required=True)
    y = xs.add_parser("add")
    y.add_argument("--id", default="")
    y.add_argument("--principal", required=True)
    y.add_argument("--secret-ref", required=True)
    y.add_argument("--secret-type", default="unknown")
    y.add_argument("--domain", default="")
    y.add_argument("--source", default="")
    y.add_argument("--privileges", default="")
    y.add_argument("--protocols-tested", default="")
    y.add_argument("--validity", default="unknown")
    y.add_argument("--last-validated", default="")
    y.add_argument("--notes", default="")
    y.set_defaults(func=credential)
    y = xs.add_parser("list")
    y.set_defaults(func=credential)
    x = sub.add_parser("key-search")
    x.add_argument("root", nargs="?", default=".")
    x.add_argument("--max-size", type=int, default=200000)
    x.set_defaults(func=key_search)
    x = sub.add_parser("evidence-manifest")
    x.add_argument("--max-files", type=int, default=50000)
    x.add_argument("--max-bytes", type=int, default=2 * 1024 * 1024 * 1024)
    x.add_argument("--require-complete", action="store_true")
    x.set_defaults(func=evidence_manifest)
    x = sub.add_parser("score-correlate")
    x.set_defaults(func=score_correlate)
    x = sub.add_parser("verified-write")
    x.add_argument("plan_id")
    x.set_defaults(func=verified_write)
    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
