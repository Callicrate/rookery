UTC = dt.timezone.utc
STREAM_CHUNK_BYTES = 64 * 1024
DEFAULT_MAX_OUTPUT_BYTES = 64 * 1024 * 1024
DEFAULT_BACKGROUND_TIMEOUT_SECONDS = 24 * 60 * 60
MAX_BACKGROUND_TIMEOUT_SECONDS = DEFAULT_BACKGROUND_TIMEOUT_SECONDS
MAX_BACKGROUND_OUTPUT_BYTES = DEFAULT_MAX_OUTPUT_BYTES
OUTPUT_LIMIT_EXIT_CODE = 125
CAPTURE_ERROR_EXIT_CODE = 74
TERMINATE_GRACE_SECONDS = 2.0
PRIVATE_DIRECTORY_MODE = 0o700
PRIVATE_FILE_MODE = 0o600
sys.path.insert(0, str(ROOT / "lib"))
sys.dont_write_bytecode = True
