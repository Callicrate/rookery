#!/usr/bin/env -S python3 -I -B
"""Manage platform-heavy pause controls without requesting full operator stop."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import stat
import sys
import tempfile
from pathlib import Path
from types import SimpleNamespace

ROOT = Path.cwd()
UTC = dt.timezone.utc
SCRIPT_ROOT = Path(__file__).resolve().parents[1]
if str(SCRIPT_ROOT / "lib") not in sys.path:
    sys.path.insert(0, str(SCRIPT_ROOT / "lib"))

from rookery.portable.adapters import run_bounded_argv
from rookery.portable.environment import (
    ChildEnvironment,
    minimal_child_environment,
)


def iso():
    return dt.datetime.now(UTC).isoformat().replace("+00:00", "Z")


def stamp():
    return dt.datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")


def _private_error(path: Path) -> ValueError:
    return ValueError(f"private path must be a regular non-symlink path: {path}")


def mkdir(p: Path) -> Path:
    path = Path(os.path.abspath(os.fspath(p)))
    workspace = Path(os.path.abspath(os.fspath(ROOT)))
    try:
        relative = path.relative_to(workspace)
    except ValueError:
        missing = []
        current = path
        while not os.path.lexists(current):
            missing.append(current)
            if current.parent == current:
                raise _private_error(path)
            current = current.parent
        state = os.lstat(current)
        if stat.S_ISLNK(state.st_mode) or not stat.S_ISDIR(state.st_mode):
            raise _private_error(current)
        for current in reversed(missing):
            os.mkdir(current, 0o700)
            os.chmod(current, 0o700)
        os.chmod(path, 0o700)
        return path
    current = workspace
    for part in relative.parts:
        current /= part
        if os.path.lexists(current):
            state = os.lstat(current)
            if stat.S_ISLNK(state.st_mode) or not stat.S_ISDIR(state.st_mode):
                raise _private_error(current)
        else:
            os.mkdir(current, 0o700)
        os.chmod(current, 0o700)
    return path


def private_file(p: Path) -> bool:
    path = Path(p)
    mkdir(path.parent)
    if not os.path.lexists(path):
        return False
    state = os.lstat(path)
    if stat.S_ISLNK(state.st_mode) or not stat.S_ISREG(state.st_mode):
        raise _private_error(path)
    os.chmod(path, 0o600)
    return True


def harden_private_tree(root: Path) -> None:
    root = mkdir(root)
    for directory, names, files in os.walk(root, followlinks=False):
        current = Path(directory)
        for name in names:
            child = current / name
            state = os.lstat(child)
            if stat.S_ISLNK(state.st_mode) or not stat.S_ISDIR(state.st_mode):
                raise _private_error(child)
            os.chmod(child, 0o700)
        for name in files:
            private_file(current / name)


def write_private_text(p: Path, text: str) -> None:
    path = Path(p)
    private_file(path)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        private_file(path)
        os.replace(temporary, path)
        os.chmod(path, 0o600)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if temporary.exists():
            temporary.unlink()


def jwrite(p: Path, obj):
    write_private_text(
        p,
        json.dumps(obj, indent=2, sort_keys=True, ensure_ascii=False) + "\n",
    )


def jread(p: Path, default=None):
    try:
        private_file(p)
        return json.loads(p.read_text(errors="replace"))
    except (OSError, ValueError, json.JSONDecodeError):
        return default


def run(cmd: list[str], environment: ChildEnvironment):
    try:
        result = run_bounded_argv(
            cmd,
            cwd=ROOT,
            timeout=30,
            max_output_bytes=256 * 1024,
            env=environment,
        )

        return SimpleNamespace(
            returncode=result.returncode,
            stdout=result.stdout.decode("utf-8", errors="replace"),
            stderr=result.stderr.decode("utf-8", errors="replace"),
            termination=result.termination,
        )
    except (OSError, RuntimeError, ValueError) as exc:

        class R:
            pass

        r = R()
        r.returncode = 999
        r.stdout = ""
        r.stderr = str(exc)
        r.termination = "launch_error"
        return r


def write_note(rec, environment: ChildEnvironment):
    rq = (
        run(["./bin/reviewer-queue", "--json"], environment)
        if (ROOT / "bin/reviewer-queue").exists()
        else None
    )
    lines = [
        "# Platform-Heavy Work Paused",
        "",
        f"Created: {iso()}",
        "",
        f"Reason: {rec.get('reason', '')}",
        "",
        f"Health path: {rec.get('health_path', '') or 'unknown'}",
        "",
        "This is not an operator stop. Local artifact analysis, writeups, safe offline solving, report harvesting, and queue review may continue. Do not start new platform-heavy lanes, direct submissions, fresh lab attempts, dynamic console work, or mutating platform actions until credentials/session health is refreshed.",
        "",
        "Resume after refresh:",
        "",
        "```bash",
        "./bin/platform-session-health --strict --json",
        './bin/platform-heavy-pause clear --reason "credentials refreshed and verified"',
        "./go",
        "```",
    ]
    if rq:
        lines += [
            "",
            "## Reviewer queue probe (best effort)",
            "",
            f"Termination: `{rq.termination}`; return code: `{rq.returncode}`.",
            "",
            "```json",
            (rq.stdout or rq.stderr).strip(),
            "```",
        ]
    write_private_text(ROOT / "AUTH_PAUSED.md", "\n".join(lines) + "\n")


def cmd_pause(args):
    harden_private_tree(ROOT / "control")
    rec = {
        "created_at": iso(),
        "reason": args.reason,
        "health_path": args.health_path,
        "source": args.source,
        "state": "platform-heavy-paused",
        "environment": args.environment.metadata()["environment"],
    }
    for name in ["AUTH_PAUSED", "PLATFORM_HEAVY_PAUSED"]:
        jwrite(ROOT / "control" / name, rec)
    write_note(rec, args.environment)
    print("platform-heavy-paused")
    print("wrote control/AUTH_PAUSED control/PLATFORM_HEAVY_PAUSED AUTH_PAUSED.md")
    return 3 if args.exit_nonzero else 0


def cmd_clear(args):
    harden_private_tree(ROOT / "control")
    rec = {"cleared_at": iso(), "reason": args.reason, "source": args.source}
    jwrite(ROOT / "control/AUTH_PAUSE_CLEARED.json", rec)
    for name in ["AUTH_PAUSED", "PLATFORM_HEAVY_PAUSED", "AUTH_EXPIRED"]:
        p = ROOT / "control" / name
        if os.path.lexists(p):
            private_file(p)
            p.unlink()
    print("platform-heavy-pause-cleared")
    return 0


def cmd_status(args):
    markers = {}
    for name in [
        "STOP_REQUESTED",
        "AUTH_PAUSED",
        "PLATFORM_HEAVY_PAUSED",
        "AUTH_EXPIRED",
    ]:
        p = ROOT / "control" / name
        if os.path.lexists(p):
            private_file(p)
            markers[name] = p.read_text(errors="replace").strip()
        else:
            markers[name] = None
    status = (
        "operator_stop"
        if markers["STOP_REQUESTED"]
        else "auth_pause"
        if (
            markers["AUTH_PAUSED"]
            or markers["PLATFORM_HEAVY_PAUSED"]
            or markers["AUTH_EXPIRED"]
        )
        else "active_or_unknown"
    )
    latest_health = ""
    hs = list((ROOT / "platform/session-health").glob("*/health.json"))
    if hs:
        latest_health = str(max(hs))
    rec = {
        "created_at": iso(),
        "status": status,
        "markers": markers,
        "latest_health": latest_health,
        "recommended_posture": (
            "wind down; operator stop requested"
            if status == "operator_stop"
            else "local-only; no new platform-heavy work"
            if status == "auth_pause"
            else "normal, subject to health checks"
        ),
    }
    if args.json:
        print(json.dumps(rec, indent=2, ensure_ascii=False))
    else:
        print(f"status={rec['status']}")
        print(f"recommended={rec['recommended_posture']}")
        if latest_health:
            print(f"latest_health={latest_health}")
    return 0


def main():
    os.umask(0o077)
    ap = argparse.ArgumentParser(
        description="Pause/resume platform-heavy work without creating STOP_REQUESTED."
    )
    sub = ap.add_subparsers(dest="cmd")
    p = sub.add_parser("pause")
    p.add_argument(
        "--reason", default="platform auth/session expired, near expiry, or unavailable"
    )
    p.add_argument("--health-path", default="")
    p.add_argument("--source", default="platform-heavy-pause")
    p.add_argument("--exit-nonzero", action="store_true")
    p.set_defaults(func=cmd_pause)
    c = sub.add_parser("clear")
    c.add_argument("--reason", default="platform health refreshed")
    c.add_argument("--source", default="operator")
    c.set_defaults(func=cmd_clear)
    s = sub.add_parser("status")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_status)
    args = ap.parse_args()
    if not hasattr(args, "func"):
        args = ap.parse_args(["status"])
    # Validate the child profile before any marker or note write. The optional
    # reviewer probe never needs session, provider, adapter, or owner state.
    args.environment = minimal_child_environment(ROOT, policy_name="platform-heavy-pause")
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
