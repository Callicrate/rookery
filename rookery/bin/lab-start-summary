#!/usr/bin/env -S python3 -I -B
"""Extract a compact lab/challenge start summary from preserved platform JSON/text evidence."""

from __future__ import annotations
import argparse
import datetime as dt
import json
import os
import re
import sys
from pathlib import Path

ROOT = Path.cwd()
UTC = dt.timezone.utc
SCRIPT_ROOT = Path(__file__).resolve().parents[1]
if str(SCRIPT_ROOT / "lib") not in sys.path:
    sys.path.insert(0, str(SCRIPT_ROOT / "lib"))

from rookery.portable.util import (  # noqa: E402
    ensure_private_dir as _ensure_private_dir,
    ensure_private_file as _ensure_private_file,
)


def iso():
    return dt.datetime.now(UTC).isoformat().replace("+00:00", "Z")


def stamp():
    return dt.datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")


def mkdir(p):
    _ensure_private_dir(Path(p))


def write_text(p, text, **kwargs):
    p = Path(p)
    _ensure_private_dir(p.parent)
    _ensure_private_file(p)
    p.write_text(text, **kwargs)
    os.chmod(p, 0o600)


def read(p):
    try:
        return Path(p).read_text(errors="replace")
    except Exception:
        return ""


def main():
    os.umask(0o077)
    ap = argparse.ArgumentParser()
    ap.add_argument("paths", nargs="*", default=["platform", "analysis", "TARGET.md"])
    ap.add_argument("--outdir", default="")
    ap.add_argument("--id", default="global")
    args = ap.parse_args()
    out = (
        Path(args.outdir)
        if args.outdir
        else ROOT / "analysis/lab-start-summary" / stamp()
    )
    mkdir(out)
    corpus = []
    for x in args.paths:
        p = Path(x)
        fs = (
            [p]
            if p.is_file()
            else list(p.rglob("*.json"))[:200]
            + list(p.rglob("*.md"))[:100]
            + list(p.rglob("*.txt"))[:100]
            if p.is_dir()
            else []
        )
        for f in fs:
            try:
                if f.stat().st_size < 2_000_000:
                    corpus.append((str(f), read(f)))
            except Exception:
                pass
    text = "\n".join(t for _, t in corpus)
    ips = sorted(set(re.findall(r"\b(?:10|172|192)\.(?:\d{1,3}\.){2}\d{1,3}\b", text)))[
        :100
    ]
    creds = re.findall(
        r"(?i)(?:user(?:name)?|login|password|pass|token|secret|key)\s*[:=]\s*[^\s,;]{2,80}",
        text,
    )[:100]
    protocols = sorted(
        set(
            x.lower()
            for x in re.findall(
                r"\b(ssh|rdp|http|https|smb|winrm|ldap|mssql|mysql|postgres|ftp|vnc)\b",
                text,
                re.I,
            )
        )
    )
    titles = re.findall(
        r'(?i)"(?:title|name|instanceName|activityName|challengeName)"\s*:\s*"([^"]{1,120})"',
        text,
    )[:80]
    questions = re.findall(
        r"(?is)(?:question|task|prompt|briefing)[^\n]{0,80}\n?(.{0,500})", text
    )[:10]
    lines = (
        [
            "# Lab Start Summary",
            "",
            f"Created: {iso()}",
            "",
            f"ID: `{args.id}`",
            "",
            "## Inputs",
            "",
        ]
        + [f"- `{p}`" for p, _ in corpus[:200]]
        + ["", "## Instance / Titles", ""]
        + [f"- {x}" for x in titles[:40] or ["none found"]]
        + [
            "",
            "## Protocols",
            "",
            ", ".join(protocols) or "none found",
            "",
            "## Private IPs",
            "",
        ]
        + [f"- `{x}`" for x in ips or ["none found"]]
        + ["", "## Credential-like fields observed", ""]
        + [f"- `{x}`" for x in creds or ["none found"]]
        + ["", "## First tasks/questions snippets", ""]
        + [f"```text\n{x[:700]}\n```" for x in questions or ["none found"]]
    )
    write_text(out / "summary.md", "\n".join(lines) + "\n", encoding="utf-8")
    write_text(out / "summary.json",
        json.dumps(
            {
                "created_at": iso(),
                "inputs": [p for p, _ in corpus],
                "titles": titles,
                "protocols": protocols,
                "private_ips": ips,
                "credential_like": creds,
                "questions": questions,
            },
            indent=2,
            ensure_ascii=False,
        )
        + "\n",
        encoding="utf-8",
    )
    print(str(out / "summary.md"))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
