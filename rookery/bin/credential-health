#!/usr/bin/env -S python3 -I -B
"""Precise credential/session freshness gate for CTF platform work.

Uses platform-specific cookie filtering when available, optional external health
commands, and creates an AUTH_PAUSED/PLATFORM_HEAVY_PAUSED marker if auth has expired and strict/auto-pause is set. It must not create STOP_REQUESTED during routine health checks.
"""

from __future__ import annotations
import argparse
import datetime as dt
import json
import os
import shlex
import stat
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path.cwd()
UTC = dt.timezone.utc
SCRIPT_ROOT = Path(__file__).resolve().parents[1]
if str(SCRIPT_ROOT / "lib") not in sys.path:
    sys.path.insert(0, str(SCRIPT_ROOT / "lib"))

from rookery.portable.adapters import MAX_ADAPTER_OUTPUT_BYTES, run_bounded_argv  # noqa: E402
from rookery.portable.environment import (  # noqa: E402
    EnvClass,
    EnvKey,
    EnvironmentPolicyError,
    build_child_environment,
    minimal_child_environment,
    parse_name_array,
    purpose_policy,
    read_declared_environment,
)

DEFAULT_MAX_OUTPUT_BYTES = 8 * 1024 * 1024
MAX_HEALTH_TIMEOUT_SECONDS = 300
MAX_HEALTH_AGE_MINUTES = 365 * 24 * 60

_CREDENTIAL_HEALTH_KEYS = (
    EnvKey("CREDENTIAL_MAX_AGE_MINUTES", EnvClass.ROOKERY_CONFIG),
    EnvKey("CREDENTIAL_HEALTH_ARGV", EnvClass.ROOKERY_CONFIG),
    EnvKey("PLATFORM_AUTH_HEALTH_ARGV", EnvClass.ROOKERY_CONFIG),
    EnvKey("CREDENTIAL_HEALTH_COMMAND", EnvClass.ROOKERY_CONFIG),
    EnvKey("PLATFORM_AUTH_HEALTH_COMMAND", EnvClass.ROOKERY_CONFIG),
    EnvKey("CREDENTIAL_HEALTH_TIMEOUT", EnvClass.ROOKERY_CONFIG),
    EnvKey("CREDENTIAL_HEALTH_ENV_KEYS", EnvClass.ROOKERY_CONFIG),
    EnvKey("AUTH_STOP_ON_EXPIRED", EnvClass.ROOKERY_CONFIG),
    EnvKey("COOKIES_LATEST", EnvClass.SESSION_SECRET_REF),
    EnvKey("COOKIES_FILE", EnvClass.SESSION_SECRET_REF),
    EnvKey("PLATFORM_COOKIES_FILE", EnvClass.SESSION_SECRET_REF),
    EnvKey("SESSION_FILE", EnvClass.SESSION_SECRET_REF),
    EnvKey("AUTH_STATE_FILE", EnvClass.SESSION_SECRET_REF),
)


def iso(ts=None):
    if ts is None:
        return dt.datetime.now(UTC).isoformat().replace("+00:00", "Z")
    return dt.datetime.fromtimestamp(float(ts), UTC).isoformat().replace("+00:00", "Z")


def stamp():
    return dt.datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")


def _private_error(path: Path) -> ValueError:
    return ValueError(f"private path must be a regular non-symlink path: {path}")


def mkdir(p: Path) -> Path:
    path = Path(os.path.abspath(os.fspath(p)))
    workspace = Path(os.path.abspath(os.fspath(ROOT)))
    try:
        relative = path.relative_to(workspace)
    except ValueError:
        missing = []
        current = path
        while not os.path.lexists(current):
            missing.append(current)
            if current.parent == current:
                raise _private_error(path)
            current = current.parent
        state = os.lstat(current)
        if stat.S_ISLNK(state.st_mode) or not stat.S_ISDIR(state.st_mode):
            raise _private_error(current)
        for current in reversed(missing):
            os.mkdir(current, 0o700)
            os.chmod(current, 0o700)
        os.chmod(path, 0o700)
        return path
    current = workspace
    for part in relative.parts:
        current /= part
        if os.path.lexists(current):
            state = os.lstat(current)
            if stat.S_ISLNK(state.st_mode) or not stat.S_ISDIR(state.st_mode):
                raise _private_error(current)
        else:
            os.mkdir(current, 0o700)
        os.chmod(current, 0o700)
    return path


def private_file(p: Path) -> bool:
    path = Path(p)
    mkdir(path.parent)
    if not os.path.lexists(path):
        return False
    state = os.lstat(path)
    if stat.S_ISLNK(state.st_mode) or not stat.S_ISREG(state.st_mode):
        raise _private_error(path)
    os.chmod(path, 0o600)
    return True


def regular_input(p: Path) -> bool:
    path = Path(p)
    if not os.path.lexists(path):
        return False
    state = os.lstat(path)
    if stat.S_ISLNK(state.st_mode) or not stat.S_ISREG(state.st_mode):
        raise _private_error(path)
    return True


def harden_private_tree(root: Path) -> None:
    root = mkdir(root)
    for directory, names, files in os.walk(root, followlinks=False):
        current = Path(directory)
        for name in names:
            child = current / name
            state = os.lstat(child)
            if stat.S_ISLNK(state.st_mode) or not stat.S_ISDIR(state.st_mode):
                raise _private_error(child)
            os.chmod(child, 0o700)
        for name in files:
            private_file(current / name)


def write_private_text(p: Path, text: str) -> None:
    path = Path(p)
    private_file(path)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        private_file(path)
        os.replace(temporary, path)
        os.chmod(path, 0o600)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if temporary.exists():
            temporary.unlink()


def jwrite(p: Path, obj):
    write_private_text(
        p,
        json.dumps(obj, indent=2, sort_keys=True, ensure_ascii=False) + "\n",
    )


def load_json(p: Path, default=None):
    try:
        private_file(p)
        return json.loads(p.read_text(errors="replace"))
    except Exception:
        return default


def run(argv, timeout, max_output_bytes=DEFAULT_MAX_OUTPUT_BYTES, *, environment=None):
    return run_bounded_argv(
        [str(argument) for argument in argv],
        cwd=ROOT,
        timeout=timeout,
        max_output_bytes=max_output_bytes,
        env=(
            environment
            if environment is not None
            else minimal_child_environment(ROOT, policy_name="credential-health-internal")
        ),
    )


def invoke_cookie_filter(args, cookie_files, outdir):
    cookie_outdir = ROOT / "platform" / "cookies" / f"credential-health-{outdir.name}"
    cmd = ["./bin/cookie-filter", "--json", "--outdir", str(cookie_outdir)]
    if args.strict:
        cmd.append("--strict")
    for source in cookie_files:
        cmd += ["--file", str(source)]
    if not cookie_files:
        return {
            "command_argv": [],
            "termination": "not_run",
            "summary": {"status": "missing"},
        }
    try:
        cp = run(cmd, 60, args.max_output_bytes)
        summary = load_json(cookie_outdir / "summary.json", {})
        return {
            "command_argv": cmd,
            "returncode": cp.returncode,
            "termination": cp.termination,
            "stdout": cp.stdout[-12000:].decode("utf-8", errors="replace"),
            "stderr": cp.stderr[-12000:].decode("utf-8", errors="replace"),
            "summary": summary,
        }
    except Exception as e:
        return {"command": cmd, "error": repr(e), "summary": {"status": "error"}}


def _bounded_argv(raw: str, *, label: str) -> list[str]:
    try:
        value = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise ValueError(f"{label} must be a JSON string array") from exc
    if (
        not isinstance(value, list)
        or not value
        or len(value) > 128
        or any(
            not isinstance(item, str)
            or not item
            or "\0" in item
            or len(item.encode()) > 8_192
            for item in value
        )
    ):
        raise ValueError(f"{label} must be a bounded non-empty string array")
    return value


def _legacy_argv(raw: str, *, label: str) -> list[str]:
    try:
        value = shlex.split(raw)
    except ValueError as exc:
        raise ValueError(f"{label} is not valid argv") from exc
    if (
        not value
        or len(value) > 128
        or any(not item or "\0" in item or len(item.encode()) > 8_192 for item in value)
    ):
        raise ValueError(f"{label} is not bounded argv")
    return value


def health_configuration(args):
    """Resolve only health controls and session references before any output."""

    resolved = read_declared_environment(ROOT, _CREDENTIAL_HEALTH_KEYS)
    values = resolved.values
    argv_json = (
        args.argv_json
        or values.get("CREDENTIAL_HEALTH_ARGV")
        or values.get("PLATFORM_AUTH_HEALTH_ARGV")
        or ""
    )
    legacy_command = (
        args.command
        or values.get("CREDENTIAL_HEALTH_COMMAND")
        or values.get("PLATFORM_AUTH_HEALTH_COMMAND")
        or ""
    )
    if argv_json and legacy_command:
        raise ValueError("health command must use one argv configuration")
    health_argv = _bounded_argv(argv_json, label="health argv") if argv_json else (
        _legacy_argv(legacy_command, label="health command") if legacy_command else []
    )
    pass_names = parse_name_array(
        values.get("CREDENTIAL_HEALTH_ENV_KEYS"),
        label="CREDENTIAL_HEALTH_ENV_KEYS",
    )
    external_environment = None
    if health_argv:
        external_environment = build_child_environment(
            ROOT,
            policy=purpose_policy("credential-health-probe"),
            pass_names=pass_names,
        )
    raw_age = args.max_age_minutes
    if raw_age is None:
        raw_age = values.get("CREDENTIAL_MAX_AGE_MINUTES", "90")
    try:
        max_age = float(raw_age)
    except (TypeError, ValueError) as exc:
        raise ValueError("credential max age is invalid") from exc
    if not 0 < max_age <= MAX_HEALTH_AGE_MINUTES:
        raise ValueError("credential max age is outside bounds")
    try:
        timeout = int(values.get("CREDENTIAL_HEALTH_TIMEOUT", "45") or 45)
    except ValueError as exc:
        raise ValueError("credential health timeout is invalid") from exc
    if not 0 < timeout <= MAX_HEALTH_TIMEOUT_SECONDS:
        raise ValueError("credential health timeout is outside bounds")
    if not 0 < args.max_output_bytes <= MAX_ADAPTER_OUTPUT_BYTES:
        raise ValueError("credential health output bound is invalid")
    configured_files = [
        values[name]
        for name in (
            "COOKIES_LATEST",
            "COOKIES_FILE",
            "PLATFORM_COOKIES_FILE",
            "SESSION_FILE",
            "AUTH_STATE_FILE",
        )
        if values.get(name)
    ]
    cookie_files = list(dict.fromkeys([*args.file, *configured_files]))
    return values, health_argv, external_environment, max_age, timeout, cookie_files


def write_auth_stop(status, rec, max_output_bytes):
    # Compatibility name retained, but routine auth failure now creates a platform-heavy pause, not a full stop.
    nl = chr(10)
    harden_private_tree(ROOT / "control")
    write_private_text(
        ROOT / "control/AUTH_EXPIRED",
        json.dumps(
            {
                "created_at": iso(),
                "status": status,
                "health_path": rec.get("health_path", ""),
            },
            indent=2,
        )
        + nl,
    )
    try:
        run(
            [
                "./bin/platform-heavy-pause",
                "pause",
                "--reason",
                f"auth health {status}",
                "--health-path",
                rec.get("health_path", ""),
                "--source",
                "credential-health",
            ],
            30,
            max_output_bytes,
        )
    except Exception:
        # Best-effort fallback; still do not create STOP_REQUESTED.
        for name in ["AUTH_PAUSED", "PLATFORM_HEAVY_PAUSED"]:
            write_private_text(
                ROOT / "control" / name,
                json.dumps(
                    {
                        "created_at": iso(),
                        "status": status,
                        "health_path": rec.get("health_path", ""),
                        "source": "credential-health-fallback",
                    },
                    indent=2,
                )
                + nl,
            )
    lines = [
        "# Platform Auth Paused",
        "",
        f"Created: {iso()}",
        "",
        f"Status: {status}",
        "",
        "Platform/session auth is expired, near expiry, or not usable. Pause platform-heavy solving until credentials are refreshed. This is not an operator stop.",
        "",
        "Run after refresh:",
        "",
        "```bash",
        "./bin/platform-session-health --strict --json",
        './bin/platform-heavy-pause clear --reason "credentials refreshed"',
        "./go",
        "```",
        "",
        "Pending queue:",
        "",
    ]
    try:
        cp = run(["./bin/reviewer-queue", "--json"], 20, max_output_bytes)
        lines.append("```json")
        lines.append(
            cp.stdout.decode("utf-8", errors="replace").strip()
            or cp.stderr.decode("utf-8", errors="replace").strip()
        )
        lines.append("```")
    except Exception as e:
        lines.append(f"- reviewer-queue unavailable: {e!r}")
    write_private_text(ROOT / "AUTH_PAUSED.md", nl.join(lines) + nl)


def main():
    os.umask(0o077)
    ap = argparse.ArgumentParser(
        description="Check platform credential/session health before networked platform operations."
    )
    ap.add_argument("--json", action="store_true")
    ap.add_argument(
        "--strict",
        action="store_true",
        help="exit nonzero on expired/stale/near-expiry/unknown auth",
    )
    ap.add_argument(
        "--stop-on-expired",
        action="store_true",
        help="compatibility alias: write AUTH_PAUSED/PLATFORM_HEAVY_PAUSED when auth is bad; does not create STOP_REQUESTED",
    )
    ap.add_argument("--max-age-minutes", type=float, default=None)
    ap.add_argument("--file", action="append", default=[])
    ap.add_argument("--command", default="")
    ap.add_argument("--argv-json", default="")
    ap.add_argument(
        "--max-output-bytes",
        type=int,
        default=DEFAULT_MAX_OUTPUT_BYTES,
    )
    args = ap.parse_args()
    try:
        (
            env,
            health_argv,
            external_environment,
            max_age,
            health_timeout,
            cookie_files,
        ) = health_configuration(args)
    except (EnvironmentPolicyError, ValueError):
        print("invalid credential-health environment or argv configuration", file=sys.stderr)
        return 2
    outdir = ROOT / "platform/session-health" / stamp()
    mkdir(ROOT / "platform")
    harden_private_tree(ROOT / "platform/session-health")
    mkdir(outdir)
    cookie_rec = invoke_cookie_filter(args, cookie_files, outdir)
    csum = cookie_rec.get("summary") or {}
    cookie_status = csum.get("status", "unknown")
    files = []
    now = time.time()
    stale = False
    # Backstop mtime check for configured auth/session files, even if not cookie-shaped.
    for k in [
        "COOKIES_LATEST",
        "COOKIES_FILE",
        "PLATFORM_COOKIES_FILE",
        "SESSION_FILE",
        "AUTH_STATE_FILE",
    ]:
        if env.get(k):
            p = Path(env[k])
            exists = regular_input(p)
            r = {"label": k, "path": str(p), "exists": exists}
            if exists:
                age = (now - p.stat().st_mtime) / 60.0
                r.update(
                    {
                        "mtime_utc": iso(p.stat().st_mtime),
                        "age_minutes": round(age, 2),
                        "stale_by_mtime": age > max_age,
                        "size": p.stat().st_size,
                    }
                )
                stale = stale or age > max_age
            files.append(r)
    cmd_rec = None
    if health_argv:
        try:
            cp = run(
                health_argv,
                health_timeout,
                args.max_output_bytes,
                environment=external_environment,
            )
            cmd_rec = {
                "command_argv": health_argv,
                "returncode": cp.returncode,
                "termination": cp.termination,
                "ok": cp.returncode == 0 and cp.termination == "exited",
                "stdout": cp.stdout[-12000:].decode("utf-8", errors="replace"),
                "stderr": cp.stderr[-12000:].decode("utf-8", errors="replace"),
                "environment": cp.environment,
            }
        except Exception as e:
            cmd_rec = {
                "command_argv": health_argv,
                "error": repr(e),
                "returncode": 999,
            }
    status = "ok"
    reasons = []
    if cookie_status in ("expired", "near_expiry", "missing", "no_relevant_cookies"):
        status = "expired" if cookie_status == "expired" else "stale"
        reasons.append("cookie_filter_" + cookie_status)
    elif cookie_status in ("unknown", "error"):
        status = "unknown"
        reasons.append("cookie_filter_" + cookie_status)
    if stale and status == "ok":
        status = "stale"
        reasons.append("auth_file_mtime_stale")
    if cmd_rec and not cmd_rec.get("ok", False):
        status = "expired" if status != "unknown" else "unknown"
        reasons.append("health_command_failed")
    if (
        not files
        and not health_argv
        and cookie_status in ("missing", "unknown", "no_relevant_cookies")
    ):
        status = "unknown-no-auth-config"
        reasons.append("no_auth_config")
    rec = {
        "created_at": iso(),
        "status": status,
        "reasons": reasons,
        "strict_exit_recommended": status not in ("ok", "unknown-no-auth-config"),
        "max_age_minutes": max_age,
        "cookie_filter": cookie_rec,
        "files": files,
        "health_command": cmd_rec,
        "note": "No redaction or mutation. This gate exists to stop before platform auth fails mid-lane.",
    }
    rec["health_path"] = str(outdir / "health.json")
    jwrite(outdir / "health.json", rec)
    auto_stop = args.stop_on_expired or (
        env.get("AUTH_STOP_ON_EXPIRED", "1").lower() in ("1", "true", "yes")
        and args.strict
    )
    if auto_stop and status in ("expired", "stale"):
        write_auth_stop(status, rec, args.max_output_bytes)
    if args.json:
        print(json.dumps(rec, indent=2, ensure_ascii=False))
    else:
        print(
            f"credential_health={status} reasons={','.join(reasons) or 'none'} snapshot={outdir / 'health.json'}"
        )
        if rec.get("cookie_filter", {}).get("summary", {}).get("header_path"):
            print("cookie_header=" + rec["cookie_filter"]["summary"]["header_path"])
    return 3 if args.strict and status not in ("ok", "unknown-no-auth-config") else 0


if __name__ == "__main__":
    raise SystemExit(main())
