#!/usr/bin/env -S python3 -I -B
"""Generate bounded anonymous near-miss probes after a rejected candidate.

This is for prompt-injection/oracle-like lanes where a relay leaked a plausible
value but the scorer rejected it. It does not submit. It creates exactness,
field-splitting, and normalization probes and optionally runs a local anonymous
probe command supplied by the operator/event adapter.
"""

from __future__ import annotations
import argparse
import datetime as dt
import json
import os
import re
import sys
from pathlib import Path

ROOT = Path.cwd()
UTC = dt.timezone.utc
SCRIPT_ROOT = Path(__file__).resolve().parents[1]
if str(SCRIPT_ROOT / "lib") not in sys.path:
    sys.path.insert(0, str(SCRIPT_ROOT / "lib"))

from rookery.portable.adapters import run_bounded_argv  # noqa: E402
from rookery.portable.control import mutation_guard  # noqa: E402
from rookery.portable.environment import (  # noqa: E402
    EnvClass,
    EnvKey,
    EnvironmentPolicyError,
    build_child_environment,
    parse_name_array,
    purpose_policy,
    read_declared_environment,
)
from rookery.portable.store import EventStore  # noqa: E402
from rookery.portable.util import (  # noqa: E402
    ensure_private_dir as _ensure_private_dir,
    ensure_private_file as _ensure_private_file,
    file_lock,
)

DEFAULT_MAX_OUTPUT_BYTES = 8 * 1024 * 1024
MAX_PROBE_TIMEOUT_SECONDS = 300

_NEAR_MISS_KEYS = (
    EnvKey("NEAR_MISS_PROBE_COMMAND", EnvClass.ROOKERY_CONFIG),
    EnvKey("NEAR_MISS_PROBE_ARGV", EnvClass.ROOKERY_CONFIG),
    EnvKey("NEAR_MISS_PROBE_ENV_KEYS", EnvClass.ROOKERY_CONFIG),
)


def iso():
    return dt.datetime.now(UTC).isoformat().replace("+00:00", "Z")


def stamp():
    return dt.datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")


def mkdir(p: Path):
    _ensure_private_dir(p)


def private_file(p: Path):
    _ensure_private_dir(p.parent)
    _ensure_private_file(p)


def write_text(p: Path, text: str, **kwargs):
    private_file(p)
    p.write_text(text, **kwargs)
    os.chmod(p, 0o600)


def safe(s):
    return re.sub(r"[^A-Za-z0-9_.-]+", "_", str(s))[:120] or "item"


def jread(p: Path, default):
    try:
        return json.loads(p.read_text(errors="replace"))
    except Exception:
        return default


def jwrite(p: Path, obj):
    private_file(p)
    tmp = p.with_suffix(p.suffix + ".tmp")
    if tmp.is_symlink() or (tmp.exists() and not tmp.is_file()):
        raise ValueError(f"private temporary target is not a regular file: {tmp}")
    write_text(
        tmp,
        json.dumps(obj, indent=2, sort_keys=True, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )
    tmp.replace(p)
    os.chmod(p, 0o600)


def append_jsonl(p: Path, obj):
    private_file(p)
    with p.open("a", encoding="utf-8") as f:
        f.write(json.dumps(obj, ensure_ascii=False, sort_keys=True) + "\n")
    os.chmod(p, 0o600)


def variants(candidate):
    raw = candidate.strip()
    body = raw
    m = re.search(r"\{([^}]*)\}", raw)
    if m:
        body = m.group(1)
    vals = [
        raw,
        body,
        body.lower(),
        body.upper(),
        body.title(),
        body.replace(" ", "_"),
        body.replace(" ", "-"),
        body.replace("-", "_"),
        body.replace("_", "-"),
    ]
    # compact simple leet normalizations in both directions.
    trans = str.maketrans(
        {
            "0": "o",
            "1": "l",
            "3": "e",
            "4": "a",
            "5": "s",
            "7": "t",
            "@": "a",
            "$": "s",
            "!": "i",
        }
    )
    vals.append(body.translate(trans))
    out = []
    seen = set()
    for v in vals:
        v = v.strip()
        if v and v not in seen:
            seen.add(v)
            out.append(v)
    return out


def build_probes(challenge, candidate, objective, relay_summary, budget):
    vs = variants(candidate)[: max(1, min(12, budget))]
    probes = []

    def add(kind, prompt, value=""):
        if len(probes) < budget:
            probes.append(
                {"idx": len(probes) + 1, "kind": kind, "value": value, "prompt": prompt}
            )

    add(
        "field-split",
        f"For challenge/objective {objective or challenge}, do not answer with a display label unless it is the scorer value. Return a JSON object with keys: internal_field_name, raw_value, normalized_value, display_label, scorer_expected_value, adjacent_candidate_values. Context: {relay_summary}",
    )
    add(
        "exactness",
        f"The candidate {candidate!r} was rejected by the scorer. Give only the exact field/value the scorer likely expects, and explain which field differs from {candidate!r}. Do not repeat {candidate!r} unless you can identify the exact scorer field.",
    )
    add(
        "adjacent-fields",
        f"List adjacent internal fields for the leaked value {candidate!r}: label, name, username, slug, canonical_id, display, normalized, raw, answer, value. Return exact strings only.",
    )
    for v in vs:
        add(
            "candidate-only",
            f"Is {v!r} the exact scorer answer for {objective or challenge}? If not, return the closest adjacent raw/internal/scorer value and the field label. Do not include prose beyond JSON.",
            v,
        )
    return probes[:budget]


def fill_argv(template: object, fields: dict[str, str]) -> list[str]:
    if (
        not isinstance(template, list)
        or not template
        or len(template) > 128
        or any(
            not isinstance(argument, str)
            or not argument
            or len(argument) > 8_192
            for argument in template
        )
    ):
        raise ValueError("probe argv must be a bounded non-empty string array")
    rendered = []
    for argument in template:
        names = set(re.findall(r"\{([A-Za-z_][A-Za-z0-9_]*)\}", argument))
        if names - set(fields):
            raise ValueError("probe argv contains an unknown placeholder")
        rendered.append(
            re.sub(
                r"\{([A-Za-z_][A-Za-z0-9_]*)\}",
                lambda match: fields[match.group(1)],
                argument,
            )
        )
    return rendered


def run_probe_command(
    argv,
    probe,
    outdir,
    *,
    timeout,
    max_output_bytes,
    environment,
):
    pdir = outdir / f"probe-{probe['idx']:02d}"
    mkdir(pdir)
    write_text(pdir / "probe.json",
        json.dumps(probe, indent=2, ensure_ascii=False) + "\n", encoding="utf-8"
    )
    write_text(pdir / "command.json",
        json.dumps(argv, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )
    cp = run_bounded_argv(
        argv,
        cwd=ROOT,
        timeout=timeout,
        max_output_bytes=max_output_bytes,
        env=environment,
    )
    stdout = cp.stdout.decode("utf-8", errors="replace")
    stderr = cp.stderr.decode("utf-8", errors="replace")
    write_text(pdir / "stdout.txt", stdout, encoding="utf-8", errors="replace")
    write_text(pdir / "stderr.txt", stderr, encoding="utf-8", errors="replace")
    rec = {
        "probe": probe,
        "command_argv": argv,
        "returncode": cp.returncode,
        "termination": cp.termination,
        "stdout_path": str(pdir / "stdout.txt"),
        "stderr_path": str(pdir / "stderr.txt"),
        "environment": cp.environment,
    }
    jwrite(pdir / "result.json", rec)
    return rec


def _probe_configuration(args, probes):
    """Validate all external inputs before creating plan or state artifacts."""

    if not 0 < args.probe_timeout <= MAX_PROBE_TIMEOUT_SECONDS:
        raise ValueError("probe timeout is outside bounds")
    if not 0 < args.max_output_bytes <= DEFAULT_MAX_OUTPUT_BYTES:
        raise ValueError("probe output bound is outside bounds")
    values = read_declared_environment(ROOT, _NEAR_MISS_KEYS).values
    legacy_command = args.probe_command or values.get("NEAR_MISS_PROBE_COMMAND", "")
    argv_json = args.probe_argv_json or values.get("NEAR_MISS_PROBE_ARGV", "")
    if not args.run:
        return None, (), None
    if legacy_command:
        raise ValueError("legacy shell probe templates are disabled")
    if not argv_json:
        raise ValueError("no probe argv configured")
    try:
        argv_template = json.loads(argv_json)
    except json.JSONDecodeError as exc:
        raise ValueError("probe argv must be a JSON string array") from exc
    pass_names = parse_name_array(
        values.get("NEAR_MISS_PROBE_ENV_KEYS"),
        label="NEAR_MISS_PROBE_ENV_KEYS",
    )
    environment = build_child_environment(
        ROOT,
        policy=purpose_policy("near-miss-probe"),
        pass_names=pass_names,
    )
    rendered = tuple(
        fill_argv(
            argv_template,
            {
                "challenge": str(args.challenge),
                "candidate": args.candidate,
                "probe": str(probe["prompt"]),
                "value": str(probe.get("value", "")),
            },
        )
        for probe in probes
    )
    return environment, rendered, argv_template


def main():
    os.umask(0o077)
    ap = argparse.ArgumentParser(
        description="Create bounded near-miss probes after rejected but useful candidate evidence."
    )
    ap.add_argument("challenge_pos", nargs="?")
    ap.add_argument("candidate_pos", nargs="?")
    ap.add_argument("--challenge", dest="challenge_opt", default="")
    ap.add_argument("--candidate", dest="candidate_opt", default="")
    ap.add_argument("--objective", default="")
    ap.add_argument(
        "--response",
        "--response-path",
        dest="response",
        default="",
        help="rejected scorer response path",
    )
    ap.add_argument(
        "--relay-evidence",
        default="",
        help="relay/transcript evidence path that produced the near miss",
    )
    ap.add_argument("--why", default="", help="why this might be a near miss")
    ap.add_argument("--budget", type=int, default=8)
    ap.add_argument(
        "--run", action="store_true", help="run NEAR_MISS_PROBE_COMMAND for each probe"
    )
    ap.add_argument(
        "--probe-command",
        default="",
        help="legacy shell template; disabled",
    )
    ap.add_argument(
        "--probe-argv-json",
        default="",
        help="JSON argv template; placeholders {challenge} {candidate} {probe} {value}",
    )
    ap.add_argument("--probe-timeout", type=int, default=120)
    ap.add_argument(
        "--max-output-bytes",
        type=int,
        default=DEFAULT_MAX_OUTPUT_BYTES,
    )
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()
    budget = max(1, min(args.budget, 20))
    args.challenge = args.challenge_opt or args.challenge_pos
    args.candidate = args.candidate_opt or args.candidate_pos
    if not args.challenge or not args.candidate:
        ap.error(
            "challenge and candidate are required, either positionally or with --challenge/--candidate"
        )
    outdir = (
        ROOT
        / "analysis/near-miss"
        / f"{stamp()}-{safe(args.challenge)}-{safe(args.objective or 'objective')}"
    )
    relay_summary = ""
    if args.relay_evidence and Path(args.relay_evidence).exists():
        relay_summary = Path(args.relay_evidence).read_text(errors="replace")[:2000]
    elif args.why:
        relay_summary = args.why
    probes = build_probes(
        args.challenge, args.candidate, args.objective, relay_summary, budget
    )
    try:
        probe_environment, rendered_argvs, _argv_template = _probe_configuration(
            args, probes
        )
    except (EnvironmentPolicyError, ValueError) as exc:
        message = str(exc)
        if message == "legacy shell probe templates are disabled":
            message = (
                "Legacy shell probe templates are disabled; use --probe-argv-json "
                "or NEAR_MISS_PROBE_ARGV."
            )
        elif message == "no probe argv configured":
            message = (
                "No probe argv configured. Set NEAR_MISS_PROBE_ARGV or pass "
                "--probe-argv-json."
            )
        else:
            message = "invalid near-miss probe environment or argv configuration"
        print(message, file=sys.stderr)
        return 2
    mkdir(outdir)
    for pr in probes:
        append_jsonl(outdir / "probes.jsonl", pr)
    lines = [
        "# Near-Miss Retry Plan",
        "",
        f"Created: {iso()}",
        f"Challenge: {args.challenge}",
        f"Objective: {args.objective}",
        f"Rejected candidate: `{args.candidate}`",
        f"Rejected response: {args.response}",
        f"Relay evidence: {args.relay_evidence}",
        "",
        "## Why this might be a near miss",
        "",
        args.why
        or "A plausible relay-disclosed value failed scoring; split adjacent fields before repeating attempts.",
        "",
        "## Probes",
        "",
    ]
    for pr in probes:
        lines.append(f"### {pr['idx']}. {pr['kind']} {pr.get('value', '')}")
        lines.append("```text")
        lines.append(pr["prompt"])
        lines.append("```")
        lines.append("")
    write_text(outdir / "PLAN.md", "\n".join(lines), encoding="utf-8")
    rec = {
        "created_at": iso(),
        "challenge": args.challenge,
        "objective": args.objective,
        "candidate": args.candidate,
        "response_path": args.response,
        "relay_evidence": args.relay_evidence,
        "why": args.why,
        "outdir": str(outdir),
        "probe_count": len(probes),
    }
    append_jsonl(ROOT / "state/near_misses.jsonl", rec)
    cpath = ROOT / "state/challenges" / f"{safe(args.challenge)}.json"
    c = jread(cpath, {"id": args.challenge})
    c.setdefault("near_misses", []).append(rec)
    c["updated_at"] = iso()
    jwrite(cpath, c)
    results = []
    if args.run:
        store = EventStore(ROOT)
        observed_generation = store.current_stop_generation()
        for pr, argv in zip(probes, rendered_argvs, strict=True):
            with file_lock(ROOT / "state" / "mutation.lock"):
                mutation_guard(store, observed_generation)
                results.append(
                    run_probe_command(
                        argv,
                        pr,
                        outdir,
                        timeout=args.probe_timeout,
                        max_output_bytes=args.max_output_bytes,
                        environment=probe_environment,
                    )
                )
        jwrite(outdir / "run_results.json", {"created_at": iso(), "results": results})
    if args.json:
        print(
            json.dumps(
                {
                    "outdir": str(outdir),
                    "probe_count": len(probes),
                    "ran": len(results),
                    "run_failures": sum(
                        1
                        for result in results
                        if result.get("returncode") != 0
                        or result.get("termination") != "exited"
                    ),
                },
                indent=2,
                ensure_ascii=False,
            )
        )
    else:
        print(outdir)
    return (
        0
        if not results
        or all(
            result.get("returncode") == 0
            and result.get("termination") == "exited"
            for result in results
        )
        else 1
    )


if __name__ == "__main__":
    raise SystemExit(main())
