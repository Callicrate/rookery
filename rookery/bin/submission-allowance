#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
case "${1:-status}" in
  status) exec "$ROOT/bin/rookery" score status ;;
  grant)
    shift
    count=${1:?count required}; shift
    kind=flag
    reason="operator allowance"
    while [ $# -gt 0 ]; do
      case "$1" in
        --kind) kind=$2; shift 2 ;;
        --reason) reason=$2; shift 2 ;;
        *) echo "unknown option: $1" >&2; exit 2 ;;
      esac
    done
    exec "$ROOT/bin/rookery" score allowance "$kind" "$count" --reason "$reason"
    ;;
  *) echo "usage: submission-allowance [status|grant N --kind flag --reason TEXT]" >&2; exit 2 ;;
esac
