#!/usr/bin/env -S python3 -I -B
"""Compatibility auth-expired hook for a platform-heavy pause, never a stop."""

from __future__ import annotations
import argparse
import datetime as dt
import json
import os
import stat
import sys
import tempfile
from pathlib import Path

ROOT = Path.cwd()
UTC = dt.timezone.utc
SCRIPT_ROOT = Path(__file__).resolve().parents[1]
if str(SCRIPT_ROOT / "lib") not in sys.path:
    sys.path.insert(0, str(SCRIPT_ROOT / "lib"))

from rookery.portable.adapters import MAX_ADAPTER_OUTPUT_BYTES, run_bounded_argv  # noqa: E402
from rookery.portable.environment import minimal_child_environment  # noqa: E402

DEFAULT_COMMAND_TIMEOUT_SECONDS = 90
MAX_COMMAND_TIMEOUT_SECONDS = 300
DEFAULT_COMMAND_OUTPUT_BYTES = 256 * 1024
MAX_COMMAND_OUTPUT_BYTES = min(8 * 1024 * 1024, MAX_ADAPTER_OUTPUT_BYTES)
MARKDOWN_TAIL_BYTES = 4 * 1024


class CommandCapture:
    def __init__(
        self,
        returncode: int,
        stdout: bytes,
        stderr: bytes,
        termination: str,
    ) -> None:
        self.returncode = returncode
        self.stdout = stdout
        self.stderr = stderr
        self.termination = termination


def iso():
    return dt.datetime.now(UTC).isoformat().replace("+00:00", "Z")


def stamp():
    return dt.datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")


def _private_error(path: Path) -> ValueError:
    return ValueError(f"private path must be a regular non-symlink path: {path}")


def mkdir(p: Path) -> Path:
    path = Path(os.path.abspath(os.fspath(p)))
    workspace = Path(os.path.abspath(os.fspath(ROOT)))
    try:
        relative = path.relative_to(workspace)
    except ValueError:
        missing = []
        current = path
        while not os.path.lexists(current):
            missing.append(current)
            if current.parent == current:
                raise _private_error(path)
            current = current.parent
        state = os.lstat(current)
        if stat.S_ISLNK(state.st_mode) or not stat.S_ISDIR(state.st_mode):
            raise _private_error(current)
        for current in reversed(missing):
            os.mkdir(current, 0o700)
            os.chmod(current, 0o700)
        os.chmod(path, 0o700)
        return path
    current = workspace
    for part in relative.parts:
        current /= part
        if os.path.lexists(current):
            state = os.lstat(current)
            if stat.S_ISLNK(state.st_mode) or not stat.S_ISDIR(state.st_mode):
                raise _private_error(current)
        else:
            os.mkdir(current, 0o700)
        os.chmod(current, 0o700)
    return path


def private_file(p: Path) -> bool:
    path = Path(p)
    mkdir(path.parent)
    if not os.path.lexists(path):
        return False
    state = os.lstat(path)
    if stat.S_ISLNK(state.st_mode) or not stat.S_ISREG(state.st_mode):
        raise _private_error(path)
    os.chmod(path, 0o600)
    return True


def harden_private_tree(root: Path) -> None:
    root = mkdir(root)
    for directory, names, files in os.walk(root, followlinks=False):
        current = Path(directory)
        for name in names:
            child = current / name
            state = os.lstat(child)
            if stat.S_ISLNK(state.st_mode) or not stat.S_ISDIR(state.st_mode):
                raise _private_error(child)
            os.chmod(child, 0o700)
        for name in files:
            private_file(current / name)


def write_private_text(p: Path, text: str) -> None:
    path = Path(p)
    private_file(path)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        private_file(path)
        os.replace(temporary, path)
        os.chmod(path, 0o600)
        directory_fd = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if temporary.exists():
            temporary.unlink()


def run(cmd: list[str], timeout: int, max_output_bytes: int) -> CommandCapture:
    """Capture one child process group under one bounded stdout/stderr budget."""
    try:
        result = run_bounded_argv(
            cmd,
            cwd=ROOT,
            timeout=timeout,
            max_output_bytes=max_output_bytes,
            env=minimal_child_environment(ROOT, policy_name="auth-expired-stop"),
        )
        return CommandCapture(
            returncode=result.returncode,
            stdout=result.stdout,
            stderr=result.stderr,
            termination=result.termination,
        )
    except (OSError, RuntimeError, ValueError):
        # Do not put a child or exception diagnostic into the auth handoff.
        return CommandCapture(127, b"", b"", "spawn_error")


def bounded_setting(value: int | None, default: int, maximum: int) -> int:
    selected = default if value is None else value
    if selected <= 0 or selected > maximum:
        raise ValueError("invalid command bound")
    return selected


def command_markdown(title: str, result: CommandCapture) -> list[str]:
    captured = result.stdout + result.stderr
    tail = captured[-MARKDOWN_TAIL_BYTES:].decode("utf-8", errors="replace")
    return [
        f"## {title}",
        "",
        f"- returncode: {result.returncode}",
        f"- termination: {result.termination}",
        f"- output_truncated: {str(result.termination == 'output_limit').lower()}",
        f"- captured_output_bytes: {len(captured)}",
        "",
        "```text",
        tail or "(no captured output)",
        "```",
        "",
    ]


def main():
    os.umask(0o077)
    ap = argparse.ArgumentParser(
        description="Pause platform-heavy work when auth is expired."
    )
    ap.add_argument(
        "--reason", default="platform auth expired or too close to expiration"
    )
    ap.add_argument("--health-path", default="")
    ap.add_argument("--run-health", action="store_true")
    ap.add_argument(
        "--command-timeout-seconds",
        type=int,
        default=None,
        help="per-command timeout (1-300 seconds)",
    )
    ap.add_argument(
        "--max-command-output-bytes",
        type=int,
        default=None,
        help="combined stdout/stderr cap per command",
    )
    ap.add_argument(
        "--operator-stop",
        action="store_true",
        help="disabled; use ./go stop for a canonical workspace stop",
    )
    args = ap.parse_args()
    if args.operator_stop:
        print(
            "--operator-stop is disabled: use ./go stop for a canonical workspace stop.",
            file=sys.stderr,
        )
        return 2
    try:
        command_timeout = bounded_setting(
            args.command_timeout_seconds,
            DEFAULT_COMMAND_TIMEOUT_SECONDS,
            MAX_COMMAND_TIMEOUT_SECONDS,
        )
        command_output_bytes = bounded_setting(
            args.max_command_output_bytes,
            DEFAULT_COMMAND_OUTPUT_BYTES,
            MAX_COMMAND_OUTPUT_BYTES,
        )
    except ValueError:
        print("invalid auth-expired-stop command bound", file=sys.stderr)
        return 2
    harden_private_tree(ROOT / "control")
    harden_private_tree(ROOT / "handoffs")
    health_result = None
    if args.run_health:
        health_result = run(
            ["./bin/platform-session-health", "--strict", "--json"],
            command_timeout,
            command_output_bytes,
        )
    write_private_text(
        ROOT / "control/AUTH_EXPIRED",
        json.dumps(
            {
                "created_at": iso(),
                "reason": args.reason,
                "health_path": args.health_path,
            },
            indent=2,
        )
        + "\n",
    )
    # Auth expiry is not an operator stop. Pause platform-heavy work only.
    run(
        [
            "./bin/platform-heavy-pause",
            "pause",
            "--reason",
            args.reason,
            "--health-path",
            args.health_path,
            "--source",
            "auth-expired-stop",
        ],
        command_timeout,
        command_output_bytes,
    )
    reviewer_queue = run(
        ["./bin/reviewer-queue", "--json"],
        command_timeout,
        command_output_bytes,
    )
    score_review = run(
        ["./bin/score-review", "status"],
        command_timeout,
        command_output_bytes,
    )
    frontier = run(
        ["./bin/frontier", "--refresh"],
        command_timeout,
        command_output_bytes,
    )
    path = ROOT / "handoffs" / f"auth-expired-stop-{stamp()}.md"
    lines = [
        "# Auth-Expired Platform Pause Notes",
        "",
        f"Created: {iso()}",
        "",
        f"Reason: {args.reason}",
        "",
        "## What happened",
        "",
        "- Platform/session auth is expired, near expiry, or not precise enough for more platform work.",
        "- New platform-heavy tasks should not start until credentials are refreshed.",
        "- Existing local evidence is preserved exactly. No redaction.",
        "",
    ]
    if health_result is None:
        lines += ["## Health output", "", "(not run)", ""]
    else:
        lines += command_markdown("Health output", health_result)
    lines += command_markdown("Pending reviewer queue", reviewer_queue)
    lines += command_markdown("Score review", score_review)
    lines += command_markdown("Frontier/status", frontier)
    lines += [
        "## Resume after auth refresh",
        "",
        "```bash",
        "./bin/platform-session-health --strict --json",
        "./bin/platform-heavy-pause clear --reason auth-refreshed",
        "./go",
        "codex",
        "```",
    ]
    write_private_text(path, "\n".join(lines) + "\n")
    write_private_text(ROOT / "AUTH_EXPIRED.md", "\n".join(lines) + "\n")
    print(f"wrote {path}")
    print(
        "Platform-heavy pause requested. Refresh credentials/session before platform-heavy solving resumes."
    )
    return 3


if __name__ == "__main__":
    raise SystemExit(main())
