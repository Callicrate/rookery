# Rookery
# Reference configuration for creating or restoring `.env`; `./go` never copies this file.
# Keep secrets in `.env`, not in this reference file. Boolean settings use 1 for enabled
# and 0 for disabled. Settings described as comma-separated should not contain spaces
# unless the value itself requires them.

# Edit only the private `.env` in the installed workspace. Rookery combines shipped
# profile defaults, the adapter selected here, typed `.env` values, and selected
# extension overlays into a resolved event. Generated state JSON is never an input.
# Every event-setting change requires a fresh measurement baseline.
# Available adapter IDs are directory names under adapters/; use manual for no API.
PLATFORM_ADAPTER=manual

# Comma-separated optional extension IDs from extensions/. Extensions can add manifest
# capabilities, agents, and tools. Blank keeps profile and adapter defaults.
EVENT_EXTENSIONS=

# Required private pre-event baseline record. Set this path before creating the baseline
# and before the first ./go. Keep it outside the Rookery source/runtime directory. The
# launch gate verifies the record and refuses a missing, unreadable, or mismatched baseline
# before creating runtime state.
ROOKERY_MEASUREMENT_BASELINE_PATH=../measurement-baseline.json

# Authentication for Codex. local-login (the default) requires an existing cached
# `codex login status` and does not pass provider, proxy, or CA variables to Codex.
# environment is for explicitly named provider credentials and requires Codex support for
# --strict-config; unsupported capability or failed login blocks launch before runtime writes.
CODEX_AUTH_MODE=local-login
CODEX_PROVIDER_ENV_KEYS=[]
CODEX_NETWORK_ENV_KEYS=[]

# Exact JSON names passed only to the scoped transit-source HTTP transport.
# Entries are limited to declared proxy/NO_PROXY aliases and CA-trust paths.
# A selected proxy is not currently an evidence transport: it fails closed
# unless a validated exact NO_PROXY rule selects the direct pinned route.
# values are never passed ambiently to unrelated tools.
TRANSIT_SOURCE_NETWORK_ENV_KEYS=[]

# Exact JSON names used only by `ncq` while choosing a TCP route. Entries may
# name proxy/NO_PROXY aliases or CA-trust paths. A selected proxy fails closed:
# `ncq` supports only a direct, DNS-pinned numeric TCP peer.
NCQ_NETWORK_ENV_KEYS=[]

# Human-readable event identity. Name is required; ID and HTTPS URL are strongly
# recommended. Timestamps use ISO-8601. Blank values retain profile defaults and may
# cause readiness to block when the field is required.
EVENT_NAME=
EVENT_ID=
EVENT_URL=
EVENT_START=
EVENT_END=

# Optional comma-separated event categories used by prioritization and presentation.
EVENT_CATEGORIES=

# Explicit acknowledgement that the declared scope is authorized. Use 1 only after
# reviewing the scope fields below; a false or missing acknowledgement blocks readiness.
EVENT_SCOPE_ACK=

# Comma-separated hostnames or IP addresses that Rookery-owned access may target.
ALLOWED_HOSTS=

# Comma-separated CIDR ranges that Rookery-owned access may target.
ALLOWED_CIDRS=

# Comma-separated integer ports permitted by the event scope.
ALLOWED_PORTS=

# Comma-separated protocols permitted by scope checks, for example http,https,tcp,udp.
ALLOWED_PROTOCOLS=

# Comma-separated local paths or attachment origins that may be ingested. This can make
# an otherwise hostless, artifact-only event scope valid.
ALLOWED_FILE_ORIGINS=

# Comma-separated platform control-plane hosts. These remain distinct from challenge
# targets and are used when a scope check is explicitly marked as platform access.
PLATFORM_HOSTS=

# Maximum permitted attachment size in bytes. Must be a positive integer.
SCOPE_MAX_BYTES=

# Scope expiration timestamp in ISO-8601 form. Blank retains the profile value.
SCOPE_EXPIRES_AT=

# Python-compatible regular expression describing expected answer or flag shape.
FLAG_REGEX=

# JSON array of nonsecret synthetic answer examples used only for morphology guidance.
ANSWER_EXAMPLES_JSON=

# Comma-separated action kinds the event supports. Canonical values are:
# flag (submit a flag), free_text (submit a text answer), multi_objective (submit one
# objective's answer), handle_write (write/claim a rotating activity handle),
# proof_artifact (submit or register a proof file), and no_submit_evidence (record local
# evidence without a platform mutation).
SCORING_ACTION_KINDS=

# Completion truth: scorer_truth or evidence_only. Evidence-only requires the sole
# action kind no_submit_evidence.
SCORING_COMPLETION_MODE=

# Comma-separated action kinds eligible for a bounded automation allowance. Blank means
# no action kind is eligible. Listing a kind does not grant authority by itself: review
# and a current bounded allowance are still required. Values must also be declared in
# SCORING_ACTION_KINDS. Usually choose from flag, free_text, multi_objective,
# handle_write, or proof_artifact. no_submit_evidence is non-mutating and does not need
# an authorization allowance.
AUTOMATION_PERMITTED_ACTION_KINDS=

# Start and maintain the queue watcher from ./go. Disabled by default; enabling it does
# not bypass independent review, authorization, scope, or stop-generation checks.
QUEUE_AUTOMATION=0

# Minimum inter-submission spacing. Leave blank to use the selected profile; set zero
# explicitly only when the platform permits immediate retries.
QUEUE_CADENCE_SECONDS=

# Deterministic per-proposal delay added after the cadence. Leave blank to use the
# selected profile. The value is bounded in seconds and remains stable across restarts.
QUEUE_JITTER_SECONDS=

# Queue latency objective in seconds. Approved proposals older than this are marked as
# breached/escalated. Zero disables the latency objective.
QUEUE_LATENCY_SECONDS=0

# Seconds between queue watcher passes when automation is enabled. Values are clamped
# to a minimum of one second by the watcher.
QUEUE_WATCH_INTERVAL_SECONDS=15

# Coordination-policy cap for concurrently active worker agents. auto uses the logical
# CPUs visible to the Rookery process, including affinity and container restrictions.
# Set a positive integer to override it. The resolved count is bound into the baseline.
CONCURRENCY_MAX_WORKERS=auto

# Coordination-policy cap for concurrent Rookery-owned background jobs.
CONCURRENCY_MAX_JOBS=8

# Maximum spawned Codex subagent threads in Rookery's single Codex session,
# excluding the primary thread. Rookery renders this value into the generated
# Codex config. The session permits one coordinator-to-solver delegation level.
CODEX_SUBAGENT_THREADS=96

# Total abstract compute units available to the useful-compute scheduler. Jobs declare
# cost_units against this budget; the value is not a CPU or GPU count.
COMPUTE_TOTAL_UNITS=8

# Compute units held back from scheduled jobs so interactive work retains capacity.
# Available scheduled-job capacity is max(0, total units - interactive reserve).
COMPUTE_INTERACTIVE_RESERVE=2

# Best-effort host CPU admission thresholds, as percentages. They must satisfy
# 0 <= admit < target <= ceiling < backoff <= 100.
COMPUTE_ADMIT_PERCENT=70
COMPUTE_TARGET_PERCENT=75
COMPUTE_CEILING_PERCENT=80
COMPUTE_BACKOFF_PERCENT=85

# CPU sample window in seconds (0 < value <= 30), cooldown in seconds (0..3600),
# lease in seconds (5..300), and default checkpointable job budget (1..86400).
COMPUTE_SAMPLE_SECONDS=1
COMPUTE_ADMISSION_COOLDOWN_SECONDS=5
COMPUTE_LEASE_SECONDS=30
COMPUTE_DEFAULT_JOB_BUDGET_SECONDS=1800

# Priority strategy (balanced or sequential) and optional JSON numeric weight object.
PRIORITY_STRATEGY=
PRIORITY_WEIGHTS_JSON=

# Choose when a complete WRITEUP.md becomes required: immediate requires it at objective
# completion; closeout defers it until final closeout. Solve capsules are always immediate.
WRITEUP_MODE=closeout

# Preparation mode used by ./go. auto discovers capabilities and may install/start missing
# ones; check and off both avoid installation and managed service startup while still
# producing preparation status (the mode label distinguishes operator intent).
ROOKERY_PREPARE_MODE=auto

# Permit distro-package installation for declared core/recommended/heavy tools and
# the managed SearXNG container engine. Browser packages are never installed by
# Rookery in this release.
ROOKERY_PREPARE_INSTALL=1

# Permit installation of optional tools classified as recommended. Effective only when
# preparation is applying changes and ROOKERY_PREPARE_INSTALL is enabled.
ROOKERY_INSTALL_RECOMMENDED=1

# Permit installation of large or specialized tools/data such as hashcat, tshark,
# binwalk, ffuf, and SecLists. Disabled by default to control disk and setup cost.
ROOKERY_INSTALL_HEAVY=0

# Permit package downloads and a digest-pinned managed SearXNG image pull. It is
# off by default: enable it only for an intentionally networked preparation run.
# Rookery never downloads or installs a browser, even when this is enabled.
ROOKERY_ALLOW_INSTALL_NETWORK=0

# Exact JSON names allowed only for preparation network work. Entries must name
# a proxy/NO_PROXY alias or CA-trust path; selected missing values fail before
# preparation. Proxy/CA names are authority, not harmless hints, and evidence
# records names/classes only. Sudo never inherits these values automatically.
ROOKERY_PREPARE_NETWORK_ENV_KEYS=[]

# Timeout in seconds for package-manager and managed-service subprocesses. This is not a
# single deadline for the whole preparation run.
ROOKERY_PREPARE_TIMEOUT=1200

# Command prefix for privileged package/container operations, parsed as shell-like tokens.
# Use sudo -n for non-interactive sudo, or leave blank when already running as root.
ROOKERY_SUDO=sudo

# SearXNG mode. auto health-checks a configured endpoint or provisions a project-owned
# local service; disabled skips both configured and managed SearXNG use.
SEARXNG_MODE=auto

# Existing SearXNG search endpoint, normally ending in /search. A non-empty value is
# health-checked and used unchanged; Rookery never replaces or manages that service.
SEARXNG_URL=

# Exact JSON names allowed only for SearXNG HTTP transport. Entries are limited
# to proxy/NO_PROXY aliases and CA-trust paths; selected missing values fail
# before a request. Values are never recorded in metadata or passed ambiently.
SEARXNG_NETWORK_ENV_KEYS=[]

# Preferred loopback port for managed SearXNG. If occupied, Rookery searches the next
# 39 ports for a free one. Ignored when SEARXNG_URL is set.
SEARXNG_LOCAL_PORT=8080

# Reviewed exact OCI image used when creating the managed SearXNG container. The
# release accepts only this official reference with its lowercase sha256 digest;
# a future image needs a fresh source review. This is local content identity, not
# a vendor-signature assertion.
SEARXNG_IMAGE=ghcr.io/searxng/searxng:2026.8.28-a30b2d474@sha256:addd2cf36efb4b9815a2820a522aef7cce4da0d1c0e4527f6675f5663332fc9b

# Container engine for managed SearXNG: auto tries Docker and then Podman; docker or
# podman requests that specific executable.
SEARXNG_CONTAINER_ENGINE=auto

# Maximum seconds to wait for a newly started SearXNG service to pass its JSON search
# health check.
SEARXNG_START_TIMEOUT=120

# Browser mode. cdp and bidi require their respective loopback endpoints at
# launch; auto retains executable discovery for operator-side research.
BROWSER_MODE=cdp

# Required Chrome DevTools endpoint for BROWSER_MODE=cdp. It must use HTTP on
# 127.0.0.1 with an explicit port. Rookery verifies /json/version before writing
# event state. Start Chrome with a separate profile, for example:
# google-chrome --remote-debugging-port=9001 --user-data-dir="$HOME/.rookery-chrome"
BROWSER_CDP_URL=http://127.0.0.1:9001

# Firefox WebDriver BiDi endpoint for BROWSER_MODE=bidi. The ctfd_browser
# adapter can use this instead of CDP. Keep it on IPv4 loopback with /session.
BROWSER_BIDI_URL=ws://127.0.0.1:9223/session

# Loopback status endpoint for the sealed browser gateway. Required by the
# ctfd_browser_gateway and skillbit adapters.
BROWSER_GATEWAY_URL=http://127.0.0.1:9003

# Preferred explicit browser executable path. When set, it is validated with --version
# and used unchanged; an invalid configured path does not fall through to auto-install.
BROWSER_EXECUTABLE=

# Compatibility fallback for tools that expect Chrome's conventional environment name.
# Used only when BROWSER_EXECUTABLE is blank; preparation exports both names when found.
CHROME_BIN=

# Reserved and inert in this release: browser capture is unreachable, so these
# names are not passed to a browser and no browser-capture metadata is produced.
# The empty compatibility selector remains only for strict configuration parsing.
BROWSER_ENV_KEYS=[]

# Optional path to rockyou.txt or a supported .txt.gz/.tar.gz archive. Blank enables
# discovery in common system paths; archives may be expanded under state/data/.
ROCKYOU_PATH=

# Optional path to the SecLists directory. Blank enables discovery in common system
# paths; package installation requires both the heavy and package-install gates.
SECLISTS_PATH=

# VPN setup is external to Rookery in this release. The shipped template has no
# VPN lifecycle, profile, health, watcher, privilege, or command selectors.
# Existing local legacy VPN_* values are ignored by Rookery and have no release
# authority; establish and stop any authorized VPN through external supervision.

# Optional bounded JSON argv for credential/session health.
CREDENTIAL_HEALTH_ARGV=

# Optional bounded JSON argv for near-miss probes.
NEAR_MISS_PROBE_ARGV=

# Adapter catalog. Set only fields declared by PLATFORM_ADAPTER; nonblank fields from an
# unselected adapter fail validation. Credential slots remain blank in this public file.
# `.env` is bounded data, never shell code.

# CTFd and CTFd browser-gateway transport. CTFD_NETWORK_ENV_KEYS is a JSON array
# of exact proxy/CA environment names. Put the token value only in private `.env`.
CTFD_URL=
CTFD_TOKEN=
CTFD_NETWORK_ENV_KEYS=

# SkillBit browser-gateway fields. URL values are exact HTTPS origins, EVENT_ID
# identifies the authorized competition, and credential slots stay blank here.
SKILLBIT_URL=
SKILLBIT_LOGIN_ORIGIN=
SKILLBIT_EVENT_ID=
SKILLBIT_ACCOUNT_ID=
SKILLBIT_PARTICIPATION_MODE=
SKILLBIT_TEAM_NAME=
SKILLBIT_USER=
SKILLBIT_EMAIL=
SKILLBIT_PASSWORD=

# Shared typed controls. Base URL and TOKEN_ENV belong to CTFd; timeout is
# 1..120 seconds, response bound is 1024..16777216 bytes, and lease is 1..300
# seconds.
ADAPTER_CONFIG_BASE_URL=
ADAPTER_CONFIG_TOKEN_ENV=
ADAPTER_CONFIG_TIMEOUT=
ADAPTER_CONFIG_MAX_RESPONSE_BYTES=
ADAPTER_CONFIG_SESSION_LEASE_SECONDS=

# Browser scoring identity. Mode is user or team. Account is required for browser
# gateway scoring; team ID is required only in team mode. TARGET_ID is optional for
# ctfd_browser. CSRF path must be an absolute path. Support origins is a duplicate-free
# JSON array of exact lower-case HTTPS origins for sealed-gateway adapters.
ADAPTER_CONFIG_SCORING_MODE=
ADAPTER_CONFIG_EXPECTED_ACCOUNT_ID=
ADAPTER_CONFIG_EXPECTED_TEAM_ID=
ADAPTER_CONFIG_TARGET_ID=
ADAPTER_CONFIG_CSRF_PAGE_PATH=
ADAPTER_CONFIG_BROWSER_SUPPORT_ORIGINS=

# Optional CTFd browser sequential unlock. Leave blank for the disabled profile
# default; set 1 when accessible rows provide unique integer positions and
# explicit solved_by_me booleans. Canonical hidden prerequisite previews may
# omit positions; malformed accessible rows still fail closed.
ADAPTER_CONFIG_SEQUENTIAL_UNLOCK=

# Guacamole extension catalogue. These fields are accepted only when
# EVENT_EXTENSIONS includes guacamole. Keep unused fields blank. ARGV values
# are JSON string arrays; ENV_KEYS values are JSON arrays of exact names.
GUAC_REMOTE_FILE_EXPORT_ARGV=
GUAC_CLIPBOARD_EXPORT_ARGV=
GUAC_BASE64_EXPORT_ARGV=
GUAC_HTTP_EXPORT_ARGV=
GUAC_SCREENSHOT_TRANSCRIBE_ARGV=
GUAC_TERMINAL_CAPTURE_ARGV=
GUAC_SSH_EXEC_ARGV=
GUAC_REMOTE_FILE_EXPORT_ENV_KEYS=
GUAC_CLIPBOARD_EXPORT_ENV_KEYS=
GUAC_BASE64_EXPORT_ENV_KEYS=
GUAC_HTTP_EXPORT_ENV_KEYS=
GUAC_SCREENSHOT_TRANSCRIBE_ENV_KEYS=
GUAC_TERMINAL_CAPTURE_ENV_KEYS=
GUAC_SSH_EXEC_ENV_KEYS=
GUAC_STREAM_DIR=
GUAC_EXEC_TIMEOUT=

# Command-backed adapters (HTB and Immersive). Values are JSON argv arrays and exact
# JSON environment-name arrays; no shell string is evaluated.
ADAPTER_CONFIG_INVENTORY_ARGV=
ADAPTER_CONFIG_SUBMIT_ARGV=
ADAPTER_CONFIG_INVENTORY_ENV_KEYS=
ADAPTER_CONFIG_SUBMIT_ENV_KEYS=

# Immersive selected-lab integration. URL/origin fields are HTTPS except ActionCable,
# which may use its documented secure WebSocket form. The cookie file is a private
# credential reference; network selectors contain names, never credential values.
IMMERSIVE_SELECTED_LAB_REFRESH_ARGV=
IMMERSIVE_SELECTED_LAB_REFRESH_ENV_KEYS=
IMMERSIVE_GRAPHQL_URL=
IMMERSIVE_SELECTED_LAB_QUERY=
IMMERSIVE_ACTIONCABLE_URL=
IMMERSIVE_ORIGIN=
IMMERSIVE_COOKIES_FILE=
IMMERSIVE_NETWORK_ENV_KEYS=
